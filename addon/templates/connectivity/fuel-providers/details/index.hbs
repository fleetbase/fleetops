<div class="space-y-4 p-4">
    {{#if this.details.totals}}
        <div class="grid grid-cols-4 gap-2">
            {{#each this.details.metrics as |metric|}}
                <section class="min-w-0 rounded-md border border-gray-200 bg-white p-3 dark:border-gray-700 dark:bg-gray-800">
                    <div class="flex items-center justify-between gap-2">
                        <h2 class="text-xs font-semibold text-gray-500 dark:text-gray-400">{{metric.label}}</h2>
                        <FaIcon @icon={{metric.icon}} class="text-blue-500" />
                    </div>
                    <div class="mt-1 text-xl font-semibold text-gray-900 dark:text-gray-100">{{metric.value}}</div>
                </section>
            {{/each}}
        </div>
    {{else}}{{#unless this.details.activityError}}
            <div class="p-4 text-sm text-gray-500" role="status">Loading integration activity…</div>
        {{/unless}}{{/if}}
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
        <section class="overflow-hidden rounded-md border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800 lg:col-span-2">
            <div class="flex items-center justify-between gap-3 border-b border-gray-200 p-4 dark:border-gray-700">
                <h2 class="text-sm font-bold text-gray-900 dark:text-gray-100">Latest sync</h2>
                <Button @icon="history" @text="View history" @size="xs" @onClick={{transition-to "connectivity.fuel-providers.details.sync"}} />
            </div>
            <div class="p-4">
                {{#if this.details.latestRun}}
                    <div class="flex flex-wrap items-center gap-3">
                        <Badge @status={{this.details.latestRun.tone}}>{{this.details.latestRun.label}}</Badge>
                        <time class="text-xs text-gray-500 dark:text-gray-400" dir="ltr">{{this.details.latestRun.date}}</time>
                    </div>
                    <p class="mt-3 text-sm text-gray-900 dark:text-gray-100" role="status">{{this.details.latestRun.result}}</p>
                    <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">Requested dates: {{this.details.latestRun.window}}</p>
                    {{#unless this.details.latestRun.received}}
                        <p class="mt-3 text-xs leading-5 text-gray-500 dark:text-gray-400">If you expected purchases, choose their dates on the Sync tab and confirm that they belong to this
                            PetroApp account.</p>
                    {{/unless}}
                {{else}}
                    <p class="text-sm text-gray-900 dark:text-gray-100">No syncs yet</p>
                    <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">Choose a purchase date range on the Sync tab to import your first transactions.</p>
                {{/if}}
            </div>
            {{#if this.details.totals.unmatched}}
                <div class="flex flex-wrap items-center justify-between gap-3 border-t border-gray-200 bg-gray-50 p-4 dark:border-gray-700 dark:bg-gray-900">
                    <span class="text-sm text-yellow-800 dark:text-yellow-300">Needs vehicle matching: {{this.details.totals.unmatched}}</span>
                    <Button @text="Review matching" @size="xs" @onClick={{transition-to "connectivity.fuel-providers.details.matching"}} />
                </div>
            {{/if}}
        </section>
        <section class="rounded-md border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800">
            <h2 class="text-sm font-bold text-gray-900 dark:text-gray-100">Account &amp; import settings</h2>
            <dl class="mt-4 space-y-4 text-sm">
                <div><dt class="text-xs text-gray-500 dark:text-gray-400">Environment</dt><dd class="mt-1 text-gray-900 dark:text-gray-100">{{this.details.environmentLabel}}</dd></div>
                <div><dt class="text-xs text-gray-500 dark:text-gray-400">Default date range</dt><dd class="mt-1 text-gray-900 dark:text-gray-100">Last
                        {{@model.sync_settings.window_days}}
                        days</dd></div>
                <div><dt class="text-xs text-gray-500 dark:text-gray-400">Fuel report creation</dt><dd class="mt-1 text-gray-900 dark:text-gray-100">{{if
                            @model.sync_settings.auto_create_fuel_reports
                            "Automatic after vehicle matching"
                            "Manual"
                        }}</dd></div>
                <div><dt class="text-xs text-gray-500 dark:text-gray-400">Total imported spend</dt><dd class="mt-1 text-gray-900 dark:text-gray-100">{{this.details.spend}}</dd></div>
            </dl>
            <Button class="mt-4" @icon="cog" @text="Edit settings" @size="xs" @onClick={{transition-to "connectivity.fuel-providers.edit" @model}} />
        </section>
    </div>
    {{#if @model.last_error}}<div
            role="alert"
            class="rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-700 dark:border-red-800 dark:bg-red-900/20 dark:text-red-300"
        >{{@model.last_error}}</div>{{/if}}
</div>
