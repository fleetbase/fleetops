<div class="h-full overflow-y-auto bg-gray-50 dark:bg-gray-900">
    <div class="flex w-full flex-col">
        <section class="sticky top-0 z-50 bg-white pt-4 shadow-sm dark:bg-gray-900">
            <div class="mx-auto flex w-full max-w-7xl flex-col gap-4 px-4 lg:flex-row lg:items-start lg:justify-between md:px-6">
                <div class="flex min-w-0 flex-1 items-start gap-3">
                    <div class="mt-1 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-md bg-blue-50 text-blue-600 dark:bg-blue-900/20 dark:text-blue-300">
                        <FaIcon @icon="gas-pump" />
                    </div>
                    <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-2">
                            <h1 class="truncate text-lg font-bold text-gray-900 dark:text-gray-100">{{or @model.name @model.provider}}</h1>
                            <Badge @status={{this.healthStatus}} @hideStatusDot={{true}}>{{this.statusLabel}}</Badge>
                        </div>
                        <div class="mt-1 text-sm text-gray-500 dark:text-gray-300">
                            {{@model.provider}}
                            ·
                            {{this.environmentLabel}}

                        </div>
                        <div class="mt-2 flex flex-wrap gap-2 text-xs text-gray-500 dark:text-gray-300">
                            <span>Last test: {{n-a (format-date-fns @model.last_tested_at "dd MMM HH:mm")}}</span>
                            <span>Last sync: {{n-a (format-date-fns @model.last_synced_at "dd MMM HH:mm")}}</span>
                            {{#if this.totals}}
                                <span>Transactions: {{this.totals.transactions}}</span>
                                <span>Needs matching: {{this.totals.unmatched}}</span>
                            {{/if}}
                        </div>
                    </div>
                </div>

                <div class="flex max-w-full flex-shrink-0 flex-nowrap items-center gap-2 overflow-x-auto">
                    <Button @icon="arrow-left" @text="Back" @size="xs" @wrapperClass="flex-shrink-0" @onClick={{transition-to "connectivity.fuel-providers.index"}} />
                    <Button @icon="plug" @text="Test" @size="xs" @wrapperClass="flex-shrink-0" @onClick={{this.openConnectionTestDialog}} />
                    <Button
                        @icon="rotate"
                        @text="Sync Transactions"
                        @type="primary"
                        @size="xs"
                        @wrapperClass="flex-shrink-0"
                        @disabled={{this.syncDisabled}}
                        @textClass="whitespace-nowrap"
                        @isLoading={{this.syncTransactions.isRunning}}
                        @onClick={{perform this.syncTransactions}}
                    />
                    <Button @icon="cog" @text="Settings" @size="xs" @wrapperClass="flex-shrink-0" @onClick={{transition-to "connectivity.fuel-providers.edit" @model}} />
                </div>
            </div>

            <nav class="mt-4 flex w-full gap-1 overflow-x-auto border-b border-gray-200 text-sm dark:border-gray-700" aria-label="Fuel integration sections">
                {{#each this.tabs as |tab|}}
                    <LinkTo
                        @route={{tab.route}}
                        class="inline-flex flex-shrink-0 items-center border-b-2 px-3 py-3 font-medium
                            {{if
                                tab.active
                                'border-blue-500 text-gray-900 dark:text-white'
                                'border-transparent text-gray-500 hover:border-blue-400 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white'
                            }}"
                    >
                        {{tab.label}}
                    </LinkTo>
                {{/each}}
            </nav>
        </section>

        {{#if this.activityError}}
            <div role="alert" class="m-4 rounded-md border border-red-300 bg-red-50 p-3 text-sm text-red-700 dark:border-red-800 dark:bg-red-900/20 dark:text-red-300">
                {{this.activityError}}
                <Button @text="Refresh" @size="xs" @onClick={{this.refreshActivity}} />
            </div>
        {{/if}}
        <section class="min-w-0">
            {{outlet}}
        </section>
    </div>
</div>
