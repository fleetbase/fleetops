<Layout::Section::Header @title={{t "settings.telematics.telematics-settings"}}>
    <Button
        @type="primary"
        @size="sm"
        @icon="save"
        @text={{t "common.save-changes"}}
        @onClick={{perform this.saveSettings}}
        @disabled={{this.saveSettings.isRunning}}
        @isLoading={{or this.saveSettings.isRunning this.getSettings.isRunning}}
    />
</Layout::Section::Header>
<Layout::Section::Body class="overflow-y-scroll-i h-full">
    <div class="container mx-auto h-screen">
        <div class="max-w-3xl my-10 mx-auto space-y-6">

            <InfoBlock @type="info" @icon="circle-info">
                {{t "settings.telematics.intro"}}
            </InfoBlock>

            {{! ── Device events ────────────────────────────────────────────── }}
            <ContentPanel @title={{t "settings.telematics.device-events"}} @open={{true}} @wrapperClass="bordered-classic">
                <InputGroup @name={{t "settings.telematics.event-retention-days"}} @helpText={{t "settings.telematics.event-retention-days-help"}}>
                    <Input @type="number" @value={{this.eventRetentionDays}} min="0" max="3650" class="w-full form-input" />
                </InputGroup>
                <InputGroup @name={{t "settings.telematics.event-compact-after-days"}} @helpText={{t "settings.telematics.event-compact-after-days-help"}}>
                    <Input @type="number" @value={{this.eventCompactAfterDays}} min="0" max="3650" class="w-full form-input" />
                </InputGroup>
                {{#if this.compactionIneffective}}
                    <InfoBlock @type="warning" @icon="triangle-exclamation">
                        {{t "settings.telematics.compaction-warning"}}
                    </InfoBlock>
                {{/if}}
            </ContentPanel>

            {{! ── Positions ────────────────────────────────────────────────── }}
            <ContentPanel @title={{t "settings.telematics.positions"}} @open={{true}} @wrapperClass="bordered-classic">
                <InputGroup @name={{t "settings.telematics.position-retention-days"}} @helpText={{t "settings.telematics.position-retention-days-help"}}>
                    <Input @type="number" @value={{this.positionRetentionDays}} min="0" max="3650" class="w-full form-input" />
                </InputGroup>
            </ContentPanel>

            {{! ── Delivery inbox & sync runs ───────────────────────────────── }}
            <ContentPanel @title={{t "settings.telematics.inbox"}} @open={{true}} @wrapperClass="bordered-classic">
                <InputGroup @name={{t "settings.telematics.processed-retention-hours"}} @helpText={{t "settings.telematics.processed-retention-hours-help"}}>
                    <Input @type="number" @value={{this.processedRetentionHours}} min="0" max="720" class="w-full form-input" />
                </InputGroup>
                <InputGroup @name={{t "settings.telematics.quarantine-retention-days"}} @helpText={{t "settings.telematics.quarantine-retention-days-help"}}>
                    <Input @type="number" @value={{this.quarantineRetentionDays}} min="0" max="365" class="w-full form-input" />
                </InputGroup>
                <InputGroup @name={{t "settings.telematics.sync-run-retention-days"}} @helpText={{t "settings.telematics.sync-run-retention-days-help"}}>
                    <Input @type="number" @value={{this.syncRunRetentionDays}} min="0" max="365" class="w-full form-input" />
                </InputGroup>
            </ContentPanel>

            {{! ── Activity logging ─────────────────────────────────────────── }}
            <ContentPanel @title={{t "settings.telematics.activity-logging"}} @open={{true}} @wrapperClass="bordered-classic">
                <InputGroup @name={{t "settings.telematics.log-telemetry-activity"}} @helpText={{t "settings.telematics.log-telemetry-activity-help"}}>
                    <Toggle @isToggled={{this.logTelemetryActivity}} @onToggle={{fn (mut this.logTelemetryActivity)}} />
                </InputGroup>
            </ContentPanel>

            {{! ── Storage usage ────────────────────────────────────────────── }}
            <ContentPanel @title={{t "settings.telematics.storage-usage"}} @open={{true}} @wrapperClass="bordered-classic">
                <div class="flex items-center justify-end gap-2 mb-3">
                    <Button @size="xs" @icon="rotate" @text={{t "settings.telematics.refresh"}} @onClick={{perform this.loadUsage}} @isLoading={{this.loadUsage.isRunning}} />
                    <Button
                        @type="danger"
                        @size="xs"
                        @icon="broom"
                        @text={{t "settings.telematics.run-cleanup"}}
                        @onClick={{this.confirmRunCleanup}}
                        @disabled={{this.runCleanup.isRunning}}
                        @isLoading={{this.runCleanup.isRunning}}
                    />
                </div>
                {{#if this.usageRows.length}}
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="text-left text-xs uppercase text-gray-500 dark:text-gray-400">
                                    <th class="py-2 pr-3">{{t "settings.telematics.table"}}</th>
                                    <th class="py-2 pr-3 text-right">{{t "settings.telematics.rows"}}</th>
                                    <th class="py-2 pr-3 text-right">{{t "settings.telematics.estimated-size"}}</th>
                                    <th class="py-2">{{t "settings.telematics.oldest"}}</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                                {{#each this.usageRows as |row|}}
                                    <tr class="text-gray-800 dark:text-gray-100">
                                        <td class="py-2 pr-3">
                                            <div class="font-medium">{{row.label}}</div>
                                            {{#if row.raw_payload_rows}}
                                                <div class="text-xs text-gray-500 dark:text-gray-400">
                                                    {{t "settings.telematics.raw-payload-rows" count=(format-number row.raw_payload_rows) compactable=(format-number row.compactable_rows)}}
                                                </div>
                                            {{/if}}
                                        </td>
                                        <td class="py-2 pr-3 text-right">{{format-number row.rows}}</td>
                                        <td class="py-2 pr-3 text-right">{{#if row.estimated_bytes}}{{format-bytes row.estimated_bytes}}{{else}}{{t "settings.telematics.not-available"}}{{/if}}</td>
                                        <td class="py-2 text-xs">{{#if row.oldest}}{{row.oldest}}{{else}}{{t "settings.telematics.not-available"}}{{/if}}</td>
                                    </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                    <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">{{t "settings.telematics.space-reclaim-note"}}</p>
                {{else if this.loadUsage.isRunning}}
                    <div class="flex items-center justify-center py-8">
                        <Spinner />
                    </div>
                {{else}}
                    <div class="text-center py-8 text-sm text-gray-400 dark:text-gray-500">
                        {{t "settings.telematics.usage-unavailable"}}
                    </div>
                {{/if}}
            </ContentPanel>

            {{! ── System defaults (administrators) ────────────────────────── }}
            {{#if this.isAdmin}}
                <ContentPanel @title={{t "settings.telematics.admin-defaults"}} @open={{false}} @wrapperClass="bordered-classic">
                    <Admin::TelematicsSettings @embedded={{true}} />
                </ContentPanel>
            {{/if}}

        </div>
    </div>
    <Spacer @height="600px" />
</Layout::Section::Body>
