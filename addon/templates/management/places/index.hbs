<Layout::Resource::Tabular
    @registry="fleet-ops:place:table"
    @resource="place"
    @title={{t "resource.places"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.placeActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="location-dot"
        title=(t "management.empty-states.places.title")
        description=(t "management.empty-states.places.description")
        filteredTitle=(t "management.empty-states.places.filtered-title")
        filteredDescription=(t "management.empty-states.places.filtered-description")
        primaryText=(t "management.empty-states.places.primary-text")
        primaryIcon="plus"
        primaryAction=this.placeActions.transition.create
        secondaryText=(t "common.import")
        secondaryIcon="upload"
        secondaryAction=this.placeActions.import
        docsSlug="fleet-ops/resources/places/overview"
        docsTitle=(t "management.empty-states.places.docs-title")
        docsText=(t "management.empty-states.places.docs-text")
        docsSource="fleet-ops-empty-places"
    }}
/>
{{outlet}}
