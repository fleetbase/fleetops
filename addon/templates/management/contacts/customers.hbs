{{#if (eq this.layout "table")}}
    <Layout::Resource::Tabular
        @registry="fleet-ops:customer:table"
        @resource="contact"
        @title={{t "resource.customers"}}
        @searchQuery={{this.query}}
        @onSearch={{perform this.customerActions.controllerSearchTask this}}
        @data={{@model}}
        @columns={{this.columns}}
        @page={{this.page}}
        @onPageChange={{fn (mut this.page)}}
        @setupTable={{fn (mut this.table)}}
        @actionButtons={{this.actionButtons}}
        @bulkActions={{this.bulkActions}}
        @controller={{this}}
        @emptyStateComponent={{component
            "table/empty-state"
            icon="user-group"
            title=(t "management.empty-states.customers.title")
            description=(t "management.empty-states.customers.description")
            filteredTitle=(t "management.empty-states.customers.filtered-title")
            filteredDescription=(t "management.empty-states.customers.filtered-description")
            primaryText=(t "management.empty-states.customers.primary-text")
            primaryIcon="plus"
            primaryAction=this.customerActions.transition.create
            secondaryText=(t "common.import")
            secondaryIcon="upload"
            secondaryAction=this.customerActions.import
        }}
        @withoutHeader={{true}}
    />
{{else}}
    <Layout::Section::Body class="overflow-y-scroll-i h-full">
        <Layout::Resource::CardsGrid
            @resource="contact"
            @data={{@model}}
            @columns="4"
            @showPagination={{true}}
            @page={{this.page}}
            @onPageChange={{fn (mut this.page)}}
            @paginationMeta={{@model.meta}}
            @containerClass="p-4"
            class="h-full"
            as |Item|
        >
            <Contact::Card @resource={{Item.model}} @resourceActions={{this.customerActions}} @placeholderType="customer" />
        </Layout::Resource::CardsGrid>
    </Layout::Section::Body>
{{/if}}
{{outlet}}
