{{#if (eq this.layout "table")}}
    <Layout::Resource::Tabular
        @registry="fleet-ops:contact:table"
        @resource="contact"
        @title={{t "resource.contacts"}}
        @searchQuery={{this.query}}
        @onSearch={{perform this.contactActions.controllerSearchTask this}}
        @data={{@model}}
        @columns={{this.columns}}
        @page={{this.page}}
        @onPageChange={{fn (mut this.page)}}
        @setupTable={{fn (mut this.table)}}
        @actionButtons={{this.actionButtons}}
        @bulkActions={{this.bulkActions}}
        @controller={{this}}
        @emptyStateComponent={{component
            "table/empty-state"
            icon="address-book"
            title=(t "management.empty-states.contacts.title")
            description=(t "management.empty-states.contacts.description")
            filteredTitle=(t "management.empty-states.contacts.filtered-title")
            filteredDescription=(t "management.empty-states.contacts.filtered-description")
            primaryText=(t "management.empty-states.contacts.primary-text")
            primaryIcon="plus"
            primaryAction=this.contactActions.transition.create
            secondaryText=(t "common.import")
            secondaryIcon="upload"
            secondaryAction=this.contactActions.import
            docsSlug="fleet-ops/resources/contacts/overview"
            docsTitle=(t "management.empty-states.contacts.docs-title")
            docsText=(t "management.empty-states.contacts.docs-text")
            docsSource="fleet-ops-empty-contacts"
        }}
        @withoutHeader={{true}}
    />
{{else}}
    <Layout::Section::Body class="overflow-y-scroll-i h-full">
        <Layout::Resource::CardsGrid
            @resource="contact"
            @data={{@model}}
            @columns="4"
            @showPagination={{true}}
            @page={{this.page}}
            @onPageChange={{fn (mut this.page)}}
            @paginationMeta={{@model.meta}}
            @containerClass="p-4"
            class="h-full"
            as |Item|
        >
            <Contact::Card @resource={{Item.model}} />
        </Layout::Resource::CardsGrid>
    </Layout::Section::Body>
{{/if}}
{{outlet}}
