<Layout::Resource::Tabular
    @registry="fleet-ops:integrated-vendor:table"
    @resource="integrated-vendor"
    @title={{t "resource.integrated-vendors"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.integratedVendorActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @setupTable={{fn (mut this.table)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="plug"
        title=(t "management.empty-states.integrated-vendors.title")
        description=(t "management.empty-states.integrated-vendors.description")
        filteredTitle=(t "management.empty-states.integrated-vendors.filtered-title")
        filteredDescription=(t "management.empty-states.integrated-vendors.filtered-description")
        docsSlug="fleet-ops/resources/vendors/integrated-vendors"
        docsTitle=(t "management.empty-states.integrated-vendors.docs-title")
        docsText=(t "management.empty-states.integrated-vendors.docs-text")
        docsSource="fleet-ops-empty-integrated-vendors"
    }}
/>
{{outlet}}
