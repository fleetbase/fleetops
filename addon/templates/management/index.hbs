<div class="fleet-ops-control-hub fleet-ops-radar" data-test-fleet-ops-radar {{radar-keyboard this.keyboardHandlers enabled=(eq this.view "list")}}>
    <Radar::Header
        @stats={{this.stats}}
        @lastLoadedAt={{this.lastLoadedAt}}
        @query={{this.q}}
        @view={{this.view}}
        @isLoading={{this.reload.isRunning}}
        @onSearch={{this.search}}
        @onReload={{perform this.reload}}
        @onNewNotice={{this.newNotice}}
        @onChangeView={{this.setView}}
    />

    <div class="fleet-ops-control-hub-body fleet-ops-radar-body">
        {{#if this.sourceErrors.length}}
            <div class="fleet-ops-radar-sources-warning" data-test-radar-sources-warning>
                <FaIcon @icon="triangle-exclamation" />
                <span>{{t "radar.sources-warning" sources=this.sourceErrorsText}}</span>
            </div>
        {{/if}}

        <Radar::Briefing
            @briefing={{this.briefing}}
            @strips={{this.strips}}
            @isLoading={{this.loadBriefing.isRunning}}
            @collapsed={{this.briefingCollapsed}}
            @busyKey={{this.busyDecisionKey}}
            @onToggle={{this.toggleBriefing}}
            @onFilterCategory={{this.filterCategory}}
            @onConfirm={{perform this.confirmDecision}}
            @onAlternative={{perform this.decisionAlternative}}
            @onDismiss={{perform this.dismissDecision}}
            @onUndo={{perform this.undoStrip}}
            @onWake={{perform this.wakeStrip}}
            @onOpenRecord={{this.openRecord}}
        />

        {{#if (eq this.view "agenda")}}
            <Radar::Agenda
                @agenda={{this.agenda}}
                @window={{this.window}}
                @isLoading={{this.loadAgenda.isRunning}}
                @onChangeWindow={{this.setWindow}}
                @onOpen={{this.openAgendaEntry}}
                @onPlan={{perform this.planItem}}
                @onHandover={{perform this.openHandover}}
                @onSeeAll={{this.showAnytimeInList}}
            />
        {{else}}
            <Radar::FilterPills @pills={{this.pills}} @isFiltered={{this.isFiltered}} @onToggle={{this.togglePill}} @onClear={{this.clearFilters}} />

            <Radar::ViewBar
                @status={{this.status}}
                @stats={{this.stats}}
                @views={{this.allViews}}
                @activeView={{this.activeView}}
                @onSetStatus={{this.setStatus}}
                @onApplyView={{this.applyView}}
                @onSaveView={{this.saveCurrentView}}
                @onDeleteView={{this.deleteView}}
            />

            {{#if this.hasSelection}}
                <Radar::BulkBar @items={{this.selectedItems}} @snoozePresets={{this.snoozePresets}} @isBusy={{this.bulkAct.isRunning}} @onAct={{perform this.bulkAct}} @onClear={{this.clearSelection}} />
            {{/if}}

            <div class="fleet-ops-radar-list" data-test-radar-list>
                {{#if this.isLoading}}
                    <div class="fleet-ops-radar-empty"><Spinner @size="lg" /></div>
                {{else if this.isEmpty}}
                    <Radar::EmptyState @status={{this.status}} @isFiltered={{this.isFiltered}} @snoozeSchedule={{this.snoozeSchedule}} @onClear={{this.clearFilters}} />
                {{else}}
                    <Radar::ItemList
                        @groups={{this.groups}}
                        @selection={{this.selection}}
                        @focusedKey={{this.focusedKey}}
                        @snoozePresets={{this.snoozePresets}}
                        @onSelect={{this.toggleSelect}}
                        @onFocus={{this.focusItem}}
                        @onOpen={{this.openDrawer}}
                        @onAct={{perform this.act}}
                        @onOpenRecord={{this.openRecord}}
                    />
                {{/if}}
            </div>

            <div class="fleet-ops-radar-footer" data-test-radar-footer>
                <Radar::KeyboardHints />
                <div class="fleet-ops-radar-footer-meta">
                    {{#if this.items.length}}
                        <span data-test-radar-showing>{{t "radar.showing" count=this.items.length total=this.meta.total}}</span>
                    {{/if}}
                    {{#if (gt this.meta.pages 1)}}
                        <div class="fleet-ops-radar-paging">
                            <Button @size="xs" @icon="chevron-left" @disabled={{eq this.meta.page 1}} @onClick={{fn this.setPage this.previousPage}} />
                            <span>{{this.meta.page}} / {{this.meta.pages}}</span>
                            <Button @size="xs" @icon="chevron-right" @disabled={{eq this.meta.page this.meta.pages}} @onClick={{fn this.setPage this.nextPage}} />
                        </div>
                    {{/if}}
                </div>
            </div>
        {{/if}}
    </div>

    <Radar::ItemDrawer @item={{this.drawerItem}} @snoozePresets={{this.snoozePresets}} @onClose={{this.closeDrawer}} @onAct={{perform this.act}} @onOpenRecord={{this.openRecord}} />
    <Radar::HandoverCard
        @handover={{this.handover}}
        @isLoading={{this.openHandover.isRunning}}
        @isBusy={{this.reassignOrders.isRunning}}
        @onClose={{this.closeHandover}}
        @onReassign={{perform this.reassignOrders}}
        @onExtend={{perform this.extendShift}}
        @onSnooze={{perform this.snoozeHandover}}
        @onOpenRecord={{this.openRecord}}
    />
</div>

{{outlet}}
