<Layout::Resource::Tabular
    @registry="fleet-ops:issue:table"
    @resource="issue"
    @title={{t "resource.issues"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.issueActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @setupTable={{fn (mut this.table)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="triangle-exclamation"
        title=(t "management.empty-states.issues.title")
        description=(t "management.empty-states.issues.description")
        filteredTitle=(t "management.empty-states.issues.filtered-title")
        filteredDescription=(t "management.empty-states.issues.filtered-description")
        primaryText=(t "management.empty-states.issues.primary-text")
        primaryIcon="plus"
        primaryAction=this.issueActions.transition.create
        secondaryText=(t "common.import")
        secondaryIcon="upload"
        secondaryAction=this.issueActions.import
        docsSlug="fleet-ops/resources/issues/overview"
        docsTitle=(t "management.empty-states.issues.docs-title")
        docsText=(t "management.empty-states.issues.docs-text")
        docsSource="fleet-ops-empty-issues"
    }}
/>
{{outlet}}
