<Layout::Resource::Panel
    @resource={{@model}}
    @controller={{this}}
    @headerComponent={{component "trailer/panel-header" resource=@model actionButtons=this.actionButtons}}
    @headerTitle={{@model.displayName}}
    @actionButtons={{this.actionButtons}}
    @onPressCancel={{transition-to "management.trailers.index"}}
    @onOverlayReady={{fn (mut this.overlay)}}
    @headerClass="no-bottom-border"
    @bodyClass="no-scroll"
>
    <TabNavigation @tabs={{this.tabs}} @containerClass="tab-navigation-fill" @contentClass="scrollable" @tablistClass="pl-2">
        {{outlet}}
    </TabNavigation>
</Layout::Resource::Panel>
