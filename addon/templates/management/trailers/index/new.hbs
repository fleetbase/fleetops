<Layout::Resource::Panel
    @resource={{this.trailer}}
    @controller={{this}}
    @headerTitle={{t "common.create-a-new-resource" resource=(t "resource.trailer")}}
    @saveTask={{this.save}}
    @onPressCancel={{transition-to "management.trailers.index"}}
    @onOverlayReady={{fn (mut this.overlay)}}
>
    <Trailer::Form @resource={{this.trailer}} @controller={{this}} />
    <Spacer @height="200px" />
</Layout::Resource::Panel>
