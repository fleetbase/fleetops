<Layout::Resource::Tabular
    @registry="fleet-ops:fleet:table"
    @resource="fleet"
    @title={{t "resource.fleets"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.fleetActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @setupTable={{fn (mut this.table)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="layer-group"
        title=(t "management.empty-states.fleets.title")
        description=(t "management.empty-states.fleets.description")
        filteredTitle=(t "management.empty-states.fleets.filtered-title")
        filteredDescription=(t "management.empty-states.fleets.filtered-description")
        primaryText=(t "management.empty-states.fleets.primary-text")
        primaryIcon="plus"
        primaryAction=this.fleetActions.transition.create
        secondaryText=(t "common.import")
        secondaryIcon="upload"
        secondaryAction=this.fleetActions.import
        docsSlug="fleet-ops/resources/fleets/overview"
        docsTitle=(t "management.empty-states.fleets.docs-title")
        docsText=(t "management.empty-states.fleets.docs-text")
        docsSource="fleet-ops-empty-fleets"
    }}
/>
{{outlet}}
