<Layout::Resource::Panel
    @resource={{this.inspectionSubmission}}
    @controller={{this}}
    @headerTitle={{t "inspection.record.create"}}
    @saveTask={{this.save}}
    @onPressCancel={{transition-to "maintenance.inspection-submissions.index"}}
    @onOverlayReady={{fn (mut this.overlay)}}
>
    <InspectionSubmission::Form @resource={{this.inspectionSubmission}} @controller={{this}} @onAnswersChange={{this.setAnswers}} />
    <Spacer @height="200px" />
</Layout::Resource::Panel>
