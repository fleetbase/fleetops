<Layout::Resource::Panel
    @resource={{@model}}
    @controller={{this}}
    @headerTitle={{t "common.edit-resource-name" resourceName=@model.name}}
    @saveTask={{this.save}}
    @onPressCancel={{this.cancel}}
    @onOverlayReady={{fn (mut this.overlay)}}
>
    <InspectionForm::Form @resource={{@model}} @controller={{this}} @onStructureChange={{this.setStructure}} />
    <Spacer @height="200px" />
</Layout::Resource::Panel>
