{{! App Review access for the Navigator app: the test number and code Apple and Google reviewers sign in with. }}
<ContentPanel @title={{t "navigator-app-review-settings.title"}} @open={{true}} @wrapperClass="bordered-classic">
    <div data-test-navigator-app-review>
        <div class="flex items-start justify-between gap-4 mb-3">
            <p class="text-sm text-gray-500 dark:text-gray-400">{{t "navigator-app-review-settings.lede"}}</p>
            {{#if this.status}}
                <Badge
                    @status={{if this.enabled "success" "default"}}
                    @text={{if this.enabled (t "navigator-app-review-settings.on") (t "navigator-app-review-settings.off")}}
                    @disableHumanize={{true}}
                    data-test-navigator-app-review-status
                />
            {{/if}}
        </div>

        {{#if this.load.isRunning}}
            <div class="py-4"><Spinner /></div>
        {{else if this.status}}
            <InputGroup @name={{t "navigator-app-review-settings.phone-label"}} @helpText={{t "navigator-app-review-settings.phone-help"}}>
                <ClickToCopy @value={{this.status.phone}} class="form-input disabled cursor-pointer" data-test-navigator-app-review-phone>{{this.status.phone_display}}</ClickToCopy>
            </InputGroup>
            <InputGroup @name={{t "navigator-app-review-settings.code-label"}}>
                {{#if this.code}}
                    <ClickToCopy @value={{this.code}} class="form-input disabled cursor-pointer font-mono tracking-widest" data-test-navigator-app-review-code>{{this.code}}</ClickToCopy>
                    <p class="mt-1 text-xs font-semibold text-yellow-700 dark:text-yellow-400">{{t "navigator-app-review-settings.code-new"}}</p>
                {{else if this.status.has_code}}
                    <div class="form-input disabled font-mono tracking-widest">••••••</div>
                    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{{t "navigator-app-review-settings.code-hidden" date=this.codeCreatedAt}}</p>
                {{else}}
                    <p class="text-xs text-gray-500 dark:text-gray-400">{{t "navigator-app-review-settings.code-none"}}</p>
                {{/if}}
            </InputGroup>

            <ul class="list-disc pl-5 text-xs text-gray-500 dark:text-gray-400 space-y-1">
                <li>{{t "navigator-app-review-settings.where"}}</li>
                <li>{{t "navigator-app-review-settings.driver"}}</li>
            </ul>

            <div class="flex flex-wrap justify-end gap-2 mt-4">
                {{#if this.enabled}}
                    <Button
                        @size="sm"
                        @icon="rotate"
                        @text={{t "navigator-app-review-settings.regenerate"}}
                        @onClick={{this.regenerate}}
                        @isLoading={{this.save.isRunning}}
                        @permission={{this.permission}}
                        data-test-navigator-app-review-regenerate
                    />
                    <Button
                        @type="danger"
                        @size="sm"
                        @icon="power-off"
                        @text={{t "navigator-app-review-settings.turn-off"}}
                        @onClick={{this.turnOff}}
                        @isLoading={{this.save.isRunning}}
                        @permission={{this.permission}}
                        data-test-navigator-app-review-turn-off
                    />
                {{else}}
                    <Button
                        @type="primary"
                        @size="sm"
                        @icon="user-check"
                        @text={{t "navigator-app-review-settings.turn-on"}}
                        @onClick={{this.turnOn}}
                        @isLoading={{this.save.isRunning}}
                        @permission={{this.permission}}
                        data-test-navigator-app-review-turn-on
                    />
                {{/if}}
            </div>
        {{/if}}
    </div>
</ContentPanel>