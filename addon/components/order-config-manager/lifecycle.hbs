<div class="oc-page px-6 py-4">
    <div class="flex gap-6 items-start">
        <div class="flex-1 min-w-0 flex flex-col gap-4">
            {{#if this.isSystemConfig}}
                <OrderConfig::Notice @icon="lock" @title={{t "order-config-manager.common.system-title"}} @text={{t "order-config-manager.lifecycle.system-banner"}} />
            {{else if this.readonly}}
                <OrderConfig::Notice @type="warning" @icon="eye" @title={{t "order-config-manager.common.readonly-title"}} @text={{t "order-config-manager.common.readonly-banner"}} />
            {{/if}}

            <section class="oc-section" aria-labelledby="oc-lifecycle-title" data-test-lifecycle>
                <div class="flex flex-col gap-1 mb-1">
                    <h2 id="oc-lifecycle-title" class="oc-section__title">{{t "order-config-manager.lifecycle.title"}}</h2>
                    <span class="oc-section__description">{{t "order-config-manager.lifecycle.description"}}</span>
                </div>
                <div class="flex flex-col">
                    {{#each this.lines as |line|}}
                        <OrderConfig::SentenceField @parts={{line.parts}} @help={{line.help}} @error={{line.error}} @unsaved={{line.unsaved}} @readonly={{this.readonly}} />
                    {{/each}}
                </div>
            </section>

            {{#if this.own}}
                <section class="oc-section oc-checks" aria-labelledby="oc-lifecycle-checks" data-test-lifecycle-checks>
                    <h2 id="oc-lifecycle-checks" class="oc-checks__title">{{t "order-config-manager.lifecycle.checks"}}</h2>
                    {{#each this.checks as |check|}}
                        <div class="oc-check {{unless check.ok 'oc-check--warning'}}">
                            <span class="oc-check__main">
                                <FaIcon @icon={{if check.ok "circle-check" "triangle-exclamation"}} class="oc-check__icon" />
                                <span class="flex flex-col gap-0.5">
                                    <span class="oc-check__title">{{check.title}}</span>
                                    {{#if check.body}}<span class="oc-check__body">{{check.body}}</span>{{/if}}
                                </span>
                            </span>
                            {{#if check.fix}}
                                <Button @type="primary" @size="sm" @text={{t "order-config-manager.lifecycle.check-dead-end-fix"}} @onClick={{check.fix}} />
                            {{/if}}
                        </div>
                    {{/each}}
                </section>
            {{/if}}

        </div>

        <aside class="oc-card oc-glance" aria-labelledby="oc-glance-title">
            <span id="oc-glance-title" class="oc-glance__title">{{t "order-config-manager.lifecycle.at-a-glance"}}</span>
            {{#each this.glance as |group|}}
                <div class="flex flex-col gap-1.5">
                    <span class="oc-glance__heading">{{group.title}}</span>
                    <div class="flex flex-wrap gap-1.5">
                        {{#each group.items as |item|}}
                            <span class="oc-role-chip oc-role-chip--{{item.role}}">
                                <FaIcon @icon={{if (eq item.role "start") "play" (if (eq item.role "complete") "check" (if (eq item.role "end") "stop" "circle"))}} @size="xs" />
                                {{item.label}}
                                {{#if item.note}}<span class="oc-role-chip__note">· {{item.note}}</span>{{/if}}
                            </span>
                        {{/each}}
                    </div>
                </div>
            {{/each}}
        </aside>
    </div>
    <OrderConfig::UnsavedBar
        @count={{this.unsavedCount}}
        @hint={{t "order-config-manager.lifecycle.save-hint"}}
        @errorHint={{this.errorHint}}
        @isSaving={{this.save.isRunning}}
        @onDiscard={{this.discard}}
        @onSave={{perform this.save}}
    />
</div>