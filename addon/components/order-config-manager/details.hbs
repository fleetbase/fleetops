<div class="px-6 py-2 space-y-4">
    <ContentPanel @title={{t "order-config-manager.details.details"}} @open={{true}} @wrapperClass="bordered-classic">
        <InputGroup @name={{t "order-config-manager.details.name"}} @value={{@config.name}} @disabled={{or @config.core_service (cannot "fleet-ops update order-config")}} />
        <InputGroup @name={{t "order-config-manager.details.description"}} @value={{@config.description}} @disabled={{or @config.core_service (cannot "fleet-ops update order-config")}} />
        <InputGroup @name={{t "order-config-manager.details.tags"}}>
            {{#let (or @config.core_service (cannot "fleet-ops update order-config")) as |disabled|}}
                <TagInput
                    class="form-input {{if disabled 'disabled'}}"
                    @placeholder={{t "order-config-manager.details.add-tags"}}
                    @allowSpacesInTags={{true}}
                    @tags={{@config.tags}}
                    @addTag={{@config.addTag}}
                    @removeTagAtIndex={{@config.removeTag}}
                    @readOnly={{disabled}}
                    as |tag|
                >
                    {{tag}}
                </TagInput>
            {{/let}}
        </InputGroup>
        <InputGroup @name={{t "order-config-manager.details.key"}} @value={{@config.key}} @disabled={{true}} />
        <InputGroup @name={{t "order-config-manager.details.namespace"}} @value={{@config.namespace}} @disabled={{true}} />
        <InputGroup @name={{t "order-config-manager.details.version"}} @value={{@config.version}} @disabled={{true}} />
    </ContentPanel>

    <ContentPanel @title={{t "order-config-manager.details.adhoc-dispatch"}} @open={{true}} @wrapperClass="bordered-classic">
        {{#let (cannot "fleet-ops update order-config") as |disabled|}}
            <InputGroup @name={{t "order-config-manager.details.adhoc-strategy"}} @helpText={{t "order-config-manager.details.adhoc-strategy-help-text"}}>
                <Select
                    @value={{this.adhocStrategy}}
                    @options={{this.strategyOptions}}
                    @optionLabel="label"
                    @optionValue="name"
                    @onSelect={{this.setAdhocStrategy}}
                    @disabled={{disabled}}
                    class="w-full"
                    data-test-config-adhoc-strategy
                />
            </InputGroup>
            <InputGroup
                @name={{t "order-config-manager.details.adhoc-offer-timeout"}}
                @type="number"
                @value={{@config.adhoc_offer_timeout}}
                @placeholder={{t "order-config-manager.details.company-default"}}
                @helpText={{t "order-config-manager.details.adhoc-offer-timeout-help-text"}}
                @disabled={{disabled}}
                data-test-config-adhoc-offer-timeout
            />
            <InputGroup @name={{t "order-config-manager.details.customer-orders-adhoc"}} @helpText={{t "order-config-manager.details.customer-orders-adhoc-help-text"}}>
                <Toggle @isToggled={{@config.customer_orders_adhoc}} @onToggle={{fn (mut @config.customer_orders_adhoc)}} @disabled={{disabled}} data-test-config-customer-orders-adhoc />
            </InputGroup>
            <InputGroup @name={{t "order-config-manager.details.match-vehicle-type"}} @helpText={{t "order-config-manager.details.match-vehicle-type-help-text"}}>
                <Toggle @isToggled={{@config.match_vehicle_type}} @onToggle={{fn (mut @config.match_vehicle_type)}} @disabled={{disabled}} data-test-config-match-vehicle-type />
            </InputGroup>
            {{#if @config.core_service}}
                <Button
                    @type="primary"
                    @icon="save"
                    @text={{t "common.save-changes"}}
                    @onClick={{perform this.save}}
                    @isLoading={{this.save.isRunning}}
                    @disabled={{not @config.hasDirtyAttributes}}
                    @permission="fleet-ops update order-config"
                />
            {{/if}}
        {{/let}}
    </ContentPanel>

    {{#unless @config.core_service}}
        <ContentPanel @title={{t "order-config-manager.details.controls"}} @open={{true}}>
            <div class="flex flex-row items-center py-2 space-x-4">
                <Button
                    @type="primary"
                    @icon="save"
                    @text={{t "common.save-changes"}}
                    @onClick={{perform this.save}}
                    @isLoading={{this.save.isRunning}}
                    @disabled={{not @config.hasDirtyAttributes}}
                    @permission="fleet-ops update order-config"
                />
                <Button
                    @type="danger"
                    @icon="trash"
                    @text={{t "order-config-manager.details.delete-config"}}
                    @onClick={{this.delete}}
                    @isLoading={{this.deleteConfig.isRunning}}
                    @permission="fleet-ops delete order-config"
                />
            </div>
        </ContentPanel>
    {{/unless}}
</div>