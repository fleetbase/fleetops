<section class="inspection-section" ...attributes>
    <div class="inspection-section__header">
        <div class="min-w-0">
            <h3 class="inspection-section__title">{{this.title}}</h3>
            {{#if @group.description}}
                <p class="inspection-section__description">{{@group.description}}</p>
            {{/if}}
        </div>
        {{#if this.statusText}}
            <div class="inspection-section__count" data-complete={{if this.isComplete "true" "false"}}>{{this.statusText}}</div>
        {{/if}}
    </div>

    {{#if this.fields}}
        <div>
            {{#each this.fields key="uuid" as |field|}}
                {{#if @readonly}}
                    <InspectionField::Value @field={{field}} @value={{get @values field.uuid}} />
                {{else}}
                    <InspectionField::Input @field={{field}} @value={{get @values field.uuid}} @subject={{@subject}} @onChange={{@onChange}} @disabled={{@disabled}} @allowUploads={{@allowUploads}} />
                {{/if}}
            {{/each}}
        </div>
    {{else}}
        <div class="inspection-section__empty">{{t "inspection.record.group-has-no-fields"}}</div>
    {{/if}}
</section>
