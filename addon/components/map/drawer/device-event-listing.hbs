<div class="flex flex-row items-center justify-between w-full px-5 py-2 border-b border-gray-200 dark:border-gray-700">
    <div class="flex flex-row items-center space-x-2">
        <div>
            <ModelSelect
                @modelName="telematic"
                @selectedItemComponent={{component "select-option/telematic" compact=true}}
                @selectedModel={{this.telematic}}
                @placeholder="Filter by Telematic"
                @triggerClass="form-select form-input form-input-sm w-48"
                @infiniteScroll={{false}}
                @renderInPlace={{true}}
                @onChange={{this.onTelematicSelected}}
                as |model|
            >
                <SelectOption::Telematic @option={{model}} />
            </ModelSelect>
        </div>

        <div>
            <ModelSelect
                @modelName="device"
                @selectedItemComponent={{component "select-option/device" compact=true}}
                @selectedModel={{this.device}}
                @placeholder="Filter by Device"
                @triggerClass="form-select form-input form-input-sm w-48"
                @infiniteScroll={{false}}
                @renderInPlace={{true}}
                @onChange={{this.onDeviceSelected}}
                as |model|
            >
                <SelectOption::Device @option={{model}} />
            </ModelSelect>
        </div>

        <div class="w-48">
            <DatePicker
                @value={{this.dateFilter}}
                @range={{true}}
                @onSelect={{this.onDateRangeChanged}}
                @autoClose={{true}}
                @placeholder="Select date range"
                class="w-full form-input form-input-sm w-48"
            />
        </div>

        {{#if this.loadEvents.isRunning}}
            <div>
                <Spinner />
            </div>
        {{/if}}
    </div>
</div>
<Table
    @rows={{this.events}}
    @columns={{this.columns}}
    @emptyStateComponent={{component
        "table/empty-state"
        variant="compact"
        icon="bolt"
        title="No device events"
        description="Events appear here after connected devices report activity for the selected filters."
    }}
/>
<Spacer @height="200px" />
