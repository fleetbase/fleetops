<div class="p-4"><div class="flex justify-end mb-3"><Button @text={{t "vehicle.actions.attach-trailer"}} @icon="link" @size="xs" @type="primary" @onClick={{this.attach}} @permission="fleet-ops attach-vehicle-for trailer" /></div>{{#if this.load.isRunning}}<Spinner />{{else if this.trailers.length}}<div class="space-y-2">{{#each this.trailers as |trailer|}}<div class="flex items-center justify-between border rounded p-3"><div><div class="font-semibold">{{trailer.displayName}}</div><div class="text-xs text-gray-500">{{trailer.type}} · {{trailer.plate_number}} · {{trailer.last_online_at}}</div></div><div class="flex space-x-1"><Button @icon="eye" @size="xs" @onClick={{fn this.trailerActions.transition.view trailer}} /><Button @icon="unlink" @size="xs" @type="danger" @onClick={{fn this.detach trailer}} @permission="fleet-ops detach-vehicle-for trailer" /></div></div>{{/each}}</div>{{else}}<div class="py-10 text-center text-gray-500">{{t "vehicle.empty.trailers"}}</div>{{/if}}</div>
