<div class="vehicle-details-trailers p-4">
    <div class="flex flex-row items-center justify-between mb-3">
        <div>
            <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100">{{t "resource.trailers"}}</h3>
            <p class="text-xs text-gray-500 dark:text-gray-400">{{t "vehicle.trailers.description"}}</p>
        </div>
        <Button @icon="link" @text={{t "vehicle.actions.attach-trailer"}} @size="xs" @type="primary" @onClick={{this.attach}} @permission="fleet-ops attach-vehicle-for trailer" />
    </div>

    {{#if this.loadTrailers.isRunning}}
        <div class="flex items-center justify-center py-10">
            <Spinner />
        </div>
    {{else if this.trailers.length}}
        <div class="overflow-x-auto">
            <table class="min-w-full text-xs">
                <thead>
                    <tr class="border-b border-gray-200 dark:border-gray-700">
                        <th class="text-left py-2 pr-4 font-semibold text-gray-500 uppercase tracking-wide">{{t "resource.trailer"}}</th>
                        <th class="text-left py-2 pr-4 font-semibold text-gray-500 uppercase tracking-wide">{{t "trailer.fields.type"}}</th>
                        <th class="text-left py-2 pr-4 font-semibold text-gray-500 uppercase tracking-wide">{{t "trailer.fields.plate-number"}}</th>
                        <th class="text-left py-2 pr-4 font-semibold text-gray-500 uppercase tracking-wide">{{t "trailer.fields.position"}}</th>
                        <th class="text-left py-2 pr-4 font-semibold text-gray-500 uppercase tracking-wide">{{t "trailer.fields.attached-at"}}</th>
                        <th class="text-left py-2 pr-4 font-semibold text-gray-500 uppercase tracking-wide">{{t "trailer.fields.connectivity"}}</th>
                        <th class="py-2"></th>
                    </tr>
                </thead>
                <tbody>
                    {{#each this.trailers as |trailer|}}
                        <tr class="border-b border-gray-100 dark:border-gray-800 hover:bg-gray-50 dark:hover:bg-gray-800">
                            <td class="py-2 pr-4 font-medium">
                                <a href="javascript:;" class="text-blue-600 dark:text-blue-400 hover:opacity-50" {{on "click" (fn this.view trailer)}}>{{trailer.displayName}}</a>
                            </td>
                            <td class="py-2 pr-4 text-gray-500">{{#if trailer.type}}{{t (concat "trailer.types." trailer.type)}}{{else}}-{{/if}}</td>
                            <td class="py-2 pr-4 text-gray-500">{{n-a trailer.plate_number}}</td>
                            <td class="py-2 pr-4 text-gray-500">{{n-a trailer.current_connection.position}}</td>
                            <td class="py-2 pr-4 text-gray-500">{{n-a (format-date-fns trailer.attached_at "dd MMM yyyy, HH:mm")}}</td>
                            <td class="py-2 pr-4"><Badge @status={{or trailer.connectivity_status "never_connected"}} @text={{t (concat "trailer.connectivity." (or trailer.connectivity_status "never_connected"))}} /></td>
                            <td class="py-2">
                                <div class="flex flex-row items-center justify-end space-x-1">
                                    <Button @icon="eye" @size="xs" @helpText={{t "common.view"}} @onClick={{fn this.view trailer}} @permission="fleet-ops view trailer" />
                                    <Button @icon="unlink" @size="xs" @type="danger" @helpText={{t "trailer.actions.detach-vehicle"}} @onClick={{fn this.detach trailer}} @permission="fleet-ops detach-vehicle-for trailer" />
                                </div>
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    {{else}}
        <div class="flex flex-col items-center justify-center py-10 text-gray-400 dark:text-gray-600">
            <FaIcon @icon="trailer" @size="2x" class="mb-3" />
            <p class="text-sm font-semibold text-gray-600 dark:text-gray-300">{{t "vehicle.empty.trailers"}}</p>
            <p class="text-xs">{{t "vehicle.empty.trailers-description"}}</p>
            <Button @text={{t "vehicle.actions.attach-trailer"}} @icon="link" @size="xs" @type="primary" class="mt-3" @onClick={{this.attach}} @permission="fleet-ops attach-vehicle-for trailer" />
        </div>
    {{/if}}
</div>
