<Layout::Resource::Card class="fleetops-resource-card vehicle-card" ...attributes as |Card|>
    <Card.header class="{{@headerClass}}">
        <RegistryYield @registry="fleet-ops:component:vehicle:card:header:start" as |RegistryComponent|>
            <RegistryComponent @order={{@resource}} @resource={{@resource}} />
        </RegistryYield>
        <div class="fleetops-card-title">
            <div class="font-semibold flex-1 truncate">{{or @resource.name @resource.yearMakeModel}}</div>
            <FaIcon @icon="circle" @size="xs" class="fleetops-card-title-indicator {{if @resource.online 'text-green-500' 'text-gray-400'}}" />
        </div>
        <div class="text-gray-400 dark:text-gray-500 text-sm w-full truncate">{{or @resource.plate_number @resource.vin @resource.serial_number @resource.call_sign @resource.public_id}}</div>
        {{#if (has-block "header")}}
            {{yield to="header"}}
        {{/if}}
        <RegistryYield @registry="fleet-ops:component:vehicle:card:header:end" as |RegistryComponent|>
            <RegistryComponent @order={{@resource}} @resource={{@resource}} />
        </RegistryYield>
    </Card.header>
    <Card.body class="{{@bodyClass}} h-40 overflow-hidden">
        <Image src={{resource-image @resource.photo_url "vehicle"}} @fallbackSrc={{(placeholder-image "vehicle")}} alt={{or @resource.name @resource.yearMakeModel}} class="fleetops-card-image fleetops-card-image--cover" />
        {{#if (has-block "body")}}
            {{yield to="body"}}
        {{/if}}
    </Card.body>
    <Card.footer class={{@footerClass}}>
        <RegistryYield @registry="fleet-ops:component:vehicle:card:footer:start" as |RegistryComponent|>
            <RegistryComponent @order={{@resource}} @resource={{@resource}} />
        </RegistryYield>
        <div class="flex flex-row items-center justify-between w-full">
            <Badge @status={{or @resource.status "default"}} @size="xs" />
            <div class="flex flex-row items-center space-x-1">
                <Button @icon="eye" @size="xs" @helpText={{t "common.view"}} @onClick={{fn this.vehicleActions.transition.view @resource}} @permission="fleet-ops view vehicle" />
                <Button @icon="pencil" @size="xs" @helpText={{t "common.edit"}} @onClick={{fn this.vehicleActions.transition.edit @resource}} @permission="fleet-ops update vehicle" />
                <Button @icon="trash" @size="xs" @type="danger" @helpText={{t "common.delete"}} @onClick={{fn this.vehicleActions.delete @resource}} @permission="fleet-ops delete vehicle" />
            </div>
        </div>
        <RegistryYield @registry="fleet-ops:component:vehicle:card:footer:end" as |RegistryComponent|>
            <RegistryComponent @order={{@resource}} @resource={{@resource}} />
        </RegistryYield>
        {{#if (has-block "footer")}}
            {{yield to="footer"}}
        {{/if}}
        <div class="fleetops-card-meta-list">
            <div class="fleetops-card-meta">
                <FaIcon @icon="id-card" @prefix="fas" />
                <span class="fleetops-card-meta-value">
                    {{#if this.driverName}}
                        {{#if @resource.driver}}
                            <a href="javascript:;" class="fleetops-card-meta-link" {{on "click" this.viewDriver}}>{{this.driverName}}</a>
                        {{else}}
                            {{this.driverName}}
                        {{/if}}
                    {{else}}
                        {{t "common.no-driver-assigned"}}
                    {{/if}}
                </span>
            </div>
            <div class="fleetops-card-meta">
                <FaIcon @icon="trailer" @prefix="fas" />
                <span class="fleetops-card-meta-value">
                    {{#each @resource.trailers as |trailer index|}}
                        {{#if index}}, {{/if}}
                        <a href="javascript:;" class="fleetops-card-meta-link" {{on "click" (fn this.viewTrailer trailer)}}>{{trailer.displayName}}</a>
                    {{else}}
                        {{t "vehicle.empty.trailers"}}
                    {{/each}}
                </span>
            </div>
            <div class="fleetops-card-meta">{{t "common.last-modified"}}: {{@resource.updatedAt}}</div>
        </div>
    </Card.footer>
</Layout::Resource::Card>
{{yield}}
