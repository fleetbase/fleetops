<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="modal-body-container">
        <InputGroup @name={{t "common.select-field" field=(t "resource.equipment")}} @helpText={{t "trailer.help.select-equipment"}}>
            <ModelSelect
                @modelName="equipment"
                @selectedModel={{@options.selectedEquipment}}
                @query={{hash attachment_state="detached"}}
                @placeholder={{t "trailer.placeholders.equipment"}}
                @triggerClass="form-select form-input"
                @infiniteScroll={{true}}
                @renderInPlace={{true}}
                @onChange={{fn (mut @options.selectedEquipment)}}
                as |equipment|
            >
                <div class="flex flex-col">
                    <span class="text-sm font-semibold">{{or equipment.name equipment.public_id}}</span>
                    <span class="text-xs text-gray-500 dark:text-gray-400">{{n-a (or equipment.type equipment.serial_number equipment.code)}}</span>
                </div>
            </ModelSelect>
        </InputGroup>
    </div>
</Modal::Default>
