<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="px-4 text-gray-900 dark:text-gray-50">
        <div class="mb-1 text-base font-semibold">
            {{t "profile-account.prompts.reset-password-heading" name=this.profile.name}}
        </div>
        <div class="text-sm mb-4">{{t "profile-account.prompts.reset-password-body"}}</div>
        <InputGroup>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <InputGroup @name={{t "profile-account.prompts.new-password"}} @type="password" @value={{this.password}} @wrapperClass="mb-0i" />
                <InputGroup @name={{t "profile-account.prompts.confirm-new-password"}} @type="password" @value={{this.confirmPassword}} @wrapperClass="mb-0i" />
            </div>
        </InputGroup>
        <InputGroup>
            <Checkbox
                @value={{this.sendCredentials}}
                @label={{t "profile-account.prompts.send-new-credentials"}}
                @onToggle={{fn (mut this.sendCredentials)}}
                @alignItems="center"
                @labelClass="mb-0i"
            />
        </InputGroup>
    </div>
</Modal::Default>