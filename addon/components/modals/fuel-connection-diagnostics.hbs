<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{this.modalOptions}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="modal-body-container space-y-4" data-test-fuel-connection-dialog>
        <div class="text-sm text-gray-500 dark:text-gray-300">{{this.connection.name}} · {{this.environment}}</div>
        <section class="rounded-md border border-gray-200 bg-gray-50 p-4 dark:border-gray-700 dark:bg-gray-900" aria-live="polite">
            <div class="flex items-center gap-2">
                {{#if (eq this.state "testing")}}<Spinner />
                {{else if (eq this.state "success")}}<FaIcon @icon="circle-check" class="text-green-500" />
                {{else if (eq this.state "failed")}}<FaIcon @icon="circle-exclamation" class="text-red-500" />
                {{else}}<FaIcon @icon="plug" class="text-blue-500" />{{/if}}
                <h3 class="text-sm font-bold text-gray-900 dark:text-gray-100">{{this.title}}</h3>
            </div>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">{{this.message}}</p>
            {{#if this.metadata.length}}
                <dl class="mt-4 grid grid-cols-1 gap-3 text-xs sm:grid-cols-2">
                    {{#each this.metadata as |entry|}}
                        <div><dt class="text-gray-500 dark:text-gray-400">{{entry.label}}</dt><dd
                                class="mt-1 break-words font-medium text-gray-900 dark:text-gray-100"
                            >{{entry.value}}</dd></div>
                    {{/each}}
                </dl>
            {{/if}}
        </section>
        {{#if this.refreshWarning}}<p class="text-xs text-yellow-600 dark:text-yellow-300" role="alert">{{this.refreshWarning}}</p>{{/if}}
        <section class="overflow-hidden rounded-md border border-gray-200 dark:border-gray-700">
            <div class="flex items-center justify-between border-b border-gray-200 p-3 dark:border-gray-700">
                <h3 class="text-xs font-semibold text-gray-600 dark:text-gray-300">Diagnostics · UTC</h3>
                <Button @icon="copy" @text="Copy diagnostics" @size="xs" @disabled={{not this.entries.length}} @onClick={{this.copyDiagnostics}} />
            </div>
            <div class="max-h-64 overflow-auto bg-gray-900 p-3 font-mono text-xs leading-5 text-gray-300" dir="ltr" data-test-fuel-test-log>
                {{#each this.entries as |entry|}}<div class="break-words"><time class="text-gray-400">[{{entry.time}}]</time> {{entry.text}}</div>
                {{else}}<p>The connection test has not started.</p>{{/each}}
            </div>
        </section>
    </div>
</Modal::Default>