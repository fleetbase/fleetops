<Modals::BulkActionModel @options={{@options}} @onConfirm={{@onConfirm}} @onDecline={{@onDecline}} as |options|>
    <div>
        <InputGroup @name={{t "common.select-field" field=(t "resource.driver")}} @helpText={{t "fleet-ops.operations.orders.index.bulk-assign-driver-helptext"}}>
            <ModelSelect
                @modelName="driver"
                @selectedItemComponent={{component "select-option/driver" compact=true}}
                @selectedModel={{options.driverAssigned}}
                @query={{options.driversQuery}}
                @placeholder={{t "order.fields.assign-driver-placeholder"}}
                @triggerClass="form-select form-input"
                @infiniteScroll={{false}}
                @renderInPlace={{true}}
                @allowClear={{true}}
                @permission="fleet-ops assign-driver-for order"
                @onChange={{options.selectDriver}}
                as |model|
            >
                <SelectOption::Driver @option={{model}} />
            </ModelSelect>
        </InputGroup>
        <InputGroup>
            <Checkbox @value={{@options.notifyDriver}} @label="Notify driver" @onToggle={{@options.toggleNotifyDriver}} @alignItems="center" @labelClass="mb-0i" />
        </InputGroup>
    </div>
</Modals::BulkActionModel>