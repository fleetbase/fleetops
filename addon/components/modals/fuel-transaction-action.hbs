<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{this.modalOptions}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="modal-body-container space-y-4" data-test-fuel-transaction-dialog>
        <p class="text-sm text-gray-600 dark:text-gray-300">{{this.description}}</p>
        <div class="max-h-64 overflow-y-auto space-y-3">
            {{#each this.preview as |purchase|}}
                <section class="rounded-md border border-gray-200 bg-gray-50 p-3 dark:border-gray-700 dark:bg-gray-900">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100">{{purchase.reference}} · {{purchase.amount}}</h3>
                        <FuelTransactionStatus @status={{purchase.status}} />
                    </div>
                    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{{purchase.provider}} · {{purchase.date}} · {{purchase.station}}</p>
                    <dl class="mt-3 grid grid-cols-2 gap-2 text-xs">
                        <div><dt class="text-gray-500">Provider plate</dt><dd class="text-gray-900 dark:text-gray-100">{{purchase.plate}}</dd></div>
                        <div><dt class="text-gray-500">Current vehicle</dt><dd class="text-gray-900 dark:text-gray-100">{{purchase.vehicle}}</dd></div>
                        <div><dt class="text-gray-500">Current order</dt><dd class="text-gray-900 dark:text-gray-100">{{purchase.order}}</dd></div>
                        <div><dt class="text-gray-500">Fuel Report</dt><dd class="text-gray-900 dark:text-gray-100">{{purchase.report}}</dd></div>
                    </dl>
                </section>
            {{/each}}
        </div>
        {{#if this.isMatching}}
            <div class="no-input-group-padding">
                <InputGroup @name={{this.selectionLabel}}>
                    <ModelSelect
                        @modelName={{this.mode}}
                        @selectedModel={{this.selected}}
                        @placeholder={{if this.isVehicle "Search vehicles" "Search orders"}}
                        @triggerClass="form-select form-input"
                        @onChange={{this.select}}
                        @allowClear={{true}}
                        as |record|
                    >
                        {{if this.isVehicle record.displayName record.public_id}}
                    </ModelSelect>
                </InputGroup>
            </div>
            {{#if this.selected}}<p class="text-sm text-gray-700 dark:text-gray-200">New match: <strong>{{this.selectedName}}</strong>. Confirm to save this selection.</p>{{/if}}
        {{/if}}
        {{#if this.error}}<p class="text-sm text-red-600 dark:text-red-300" role="alert">{{this.error}}</p>{{/if}}
    </div>
</Modal::Default>