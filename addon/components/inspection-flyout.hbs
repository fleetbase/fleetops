{{#if this.mount}}
    {{#in-element this.mount insertBefore=null}}
        {{#if this.isSheet}}
            <div class="inspection-flyout-backdrop" aria-hidden="true"></div>
        {{/if}}
        <div
            class="inspection-flyout inspection-flyout--{{this.presentation}}"
            role="dialog"
            aria-modal="false"
            aria-label={{@title}}
            tabindex="-1"
            {{inspection-flyout this.anchor presentation=this.presentation focus=this.focusTarget onDismiss=this.dismiss}}
        >
            {{#unless this.isSheet}}
                <span class="inspection-flyout__caret" aria-hidden="true"></span>
            {{/unless}}
            <div class="inspection-flyout__head">
                <span class="inspection-flyout__title">{{@title}}</span>
                <button type="button" class="inspection-flyout__close" aria-label={{t "inspection.flyout.close"}} {{on "click" (fn this.dismiss "close")}}>
                    <FaIcon @icon="times" />
                </button>
            </div>
            <div class="inspection-flyout__body">
                {{yield}}
            </div>
            <div class="inspection-flyout__foot">
                {{#if @note}}
                    <span class="inspection-flyout__note">{{@note}}</span>
                {{/if}}
                <Button @type="primary" @size="sm" @text={{t "inspection.flyout.done"}} @onClick={{fn this.dismiss "done"}} />
            </div>
        </div>
    {{/in-element}}
{{/if}}
