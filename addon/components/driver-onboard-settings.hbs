<ContentPanel @title={{t "driver-onboard-settings.driver-onboard-settings"}} @open={{true}} @wrapperClass="bordered-classic">
    {{#if this.driverOnboardSettingsLoaded}}
        <InputGroup>
            <div class="flex items-center">
                <Toggle
                    @isToggled={{this.driverOnboardSettings.enableDriverOnboardFromApp}}
                    @onToggle={{this.enableDriverOnboard}}
                    @label={{t "driver-onboard-settings.enable-driver-onboard-from-app"}}
                    @helpText={{t "driver-onboard-settings.enable-driver-onboard-from-app-help-text"}}
                />
            </div>
        </InputGroup>
        {{#if this.driverOnboardSettings.enableDriverOnboardFromApp}}
            <InputGroup @name={{t "driver-onboard-settings.select-onboard-method"}} @helpText={{t "driver-onboard-settings.select-onboard-method-help-text"}}>
                <Select
                    class="w-full flex-1"
                    @value={{this.driverOnboardSettings.driverOnboardAppMethod}}
                    @options={{this.driverOnboardMethods}}
                    @placeholder={{t "driver-onboard-settings.select-onboard-method"}}
                    @onSelect={{this.selectDriverOnboardMethod}}
                />
            </InputGroup>
            <InputGroup>
                <div class="flex items-center">
                    <Toggle
                        @isToggled={{this.driverOnboardSettings.driverMustProvideOnboardDocuments}}
                        @onToggle={{this.enableDriverOnboardDocuments}}
                        @label={{t "driver-onboard-settings.require-driver-to-upload-onboard-documents"}}
                        @helpText={{t "driver-onboard-settings.require-driver-to-upload-onboard-documents-help-text"}}
                    />
                </div>
            </InputGroup>
            {{#if this.driverOnboardSettings.driverMustProvideOnboardDocuments}}
                <InputGroup>
                    <ArrayInput
                        @data={{this.driverOnboardSettings.requiredOnboardDocuments}}
                        @placeholder={{t "driver-onboard-settings.enter-document-name"}}
                        @onDataChanged={{this.onOnboardDocumentsChanged}}
                        @addButtonText={{t "driver-onboard-settings.add-onboard-document"}}
                    >
                        <InputLabel @labelText={{t "driver-onboard-settings.required-onboard-documents"}} @helpText={{t "driver-onboard-settings.required-onboard-documents-help-text"}} />
                    </ArrayInput>
                </InputGroup>
            {{/if}}
        {{/if}}
        {{#if this.showsJoinCode}}
            <div class="mt-4 p-4 rounded-lg border border-gray-200 dark:border-gray-700">
                <p class="text-sm dark:text-gray-200 text-gray-800 mb-1 font-semibold">{{t "driver-onboard-settings.join-title"}}</p>
                <p class="text-xs dark:text-gray-400 text-gray-600 mb-3">{{t "driver-onboard-settings.join-help"}}</p>
                <div class="flex flex-col md:flex-row md:items-start gap-6">
                    <div class="flex flex-col items-center shrink-0">
                        <div class="p-3 rounded-lg bg-white border border-gray-200 dark:border-gray-700">
                            <img src={{this.join.qrCode}} alt={{t "driver-onboard-settings.join-qr-alt"}} width="180" height="180" class="block" />
                        </div>
                        <div class="mt-3">
                            <Button @size="xs" @icon="download" @text={{t "driver-onboard-settings.join-download"}} @onClick={{this.downloadJoinQrCode}} />
                        </div>
                    </div>
                    <div class="flex-1 min-w-0">
                        <InputGroup @name={{t "driver-onboard-settings.join-code"}} @helpText={{t "driver-onboard-settings.join-code-help"}}>
                            <ClickToCopy class="inline-block px-4 py-2 border rounded-md bg-gray-100 shadow-sm dark:bg-gray-700 border-gray-200 dark:border-gray-800 font-mono text-lg tracking-widest" @value={{this.join.joinCode}}>{{this.join.joinCode}}</ClickToCopy>
                        </InputGroup>
                        <Button
                            @size="xs"
                            @icon="rotate"
                            @text={{t "driver-onboard-settings.join-replace"}}
                            @onClick={{perform this.rotateJoinCode}}
                            @isLoading={{this.rotateJoinCode.isRunning}}
                            @permission="fleet-ops update navigator-settings"
                        />
                        <p class="text-xs dark:text-gray-400 text-gray-600 mt-2">{{t "driver-onboard-settings.join-replace-help"}}</p>
                    </div>
                </div>
            </div>
        {{/if}}
        <div class="mt-3 flex items-center mb-4">
            <Button
                @type="primary"
                @size="sm"
                @icon="save"
                @text={{t "common.save-changes"}}
                @onClick={{perform this.saveDriverOnboardSettings}}
                @isLoading={{not this.saveDriverOnboardSettings.isIdle}}
                @permission="fleet-ops update navigator-settings"
            />
        </div>
    {{/if}}
</ContentPanel>