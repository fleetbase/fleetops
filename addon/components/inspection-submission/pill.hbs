{{#let (or @submission @resource) as |resource|}}
    <Pill
        @resource={{resource}}
        @onClick={{@onClick}}
        @anchorClass={{@anchorClass}}
        @imageWrapperClass={{@imageWrapperClass}}
        @contentWrapperClass={{@contentWrapperClass}}
        ...attributes
    >
        <:image>
            <div class="flex h-7 w-7 items-center justify-center rounded-md bg-gray-100 text-gray-500 dark:bg-gray-800 dark:text-gray-400">
                <FaIcon @icon="clipboard-check" @size="sm" />
            </div>
        </:image>
        <:default>
            <div class="text-sm">{{n-a (or resource.form.name resource.form_name) resource.public_id}}</div>
            <div class="flex flex-row items-center gap-1.5">
                {{! A draft has no result yet; an empty badge is just a coloured dot. }}
                {{#if resource.result}}
                    <Badge @status={{if (eq resource.result "failed") "failed" "passed"}}>{{smart-humanize resource.result}}</Badge>
                {{/if}}
                <span class="text-xs text-gray-400 dark:text-gray-500">{{n-a resource.submittedAt}}</span>
            </div>
        </:default>
    </Pill>
{{/let}}
