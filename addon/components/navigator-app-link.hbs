<ContentPanel @title={{t "navigator-app-link.title"}} @open={{true}} @wrapperClass="bordered-classic">
    {{#if this.load.isRunning}}
        <div class="flex items-center justify-center py-8">
            <Spinner class="text-sm flex flex-row items-center" />
        </div>
    {{else if this.failed}}
        <InfoBlock class="warning" @text={{t "navigator-app-link.unavailable"}} />
    {{else if this.link}}
        {{#unless this.link.usesPlatformToken}}
            <InfoBlock class="mb-4 warning" @text={{t "navigator-app-link.organization-key-warning"}} />
        {{/unless}}

        <div class="flex flex-col md:flex-row md:items-start gap-6">
            <div class="flex flex-col items-center shrink-0">
                <div class="p-3 rounded-lg bg-white border border-gray-200 dark:border-gray-700">
                    <img src={{this.qrCode}} alt={{t "navigator-app-link.qr-alt"}} width="220" height="220" class="block" />
                </div>
                <div class="flex items-center space-x-2 mt-3">
                    <Button @size="xs" @icon="download" @text={{t "navigator-app-link.download"}} @onClick={{this.downloadQrCode}} />
                    <Button @size="xs" @icon="print" @text={{t "navigator-app-link.print"}} @onClick={{this.printQrCode}} />
                </div>
            </div>

            <div class="flex-1 min-w-0">
                <p class="text-sm dark:text-gray-200 text-gray-800 mb-1 font-semibold">{{t "navigator-app-link.how-title"}}</p>
                <ol class="list-decimal pl-5 text-sm dark:text-gray-300 text-gray-700 space-y-1 mb-4">
                    <li>{{t "navigator-app-link.how-1"}}</li>
                    <li>{{t "navigator-app-link.how-2"}}</li>
                    <li>{{t "navigator-app-link.how-3"}}</li>
                </ol>

                <InputGroup @name={{t "navigator-app-link.link"}} @helpText={{t "navigator-app-link.link-help"}}>
                    <ClickToCopy class="block px-4 py-2 border rounded-md bg-gray-100 shadow-sm dark:bg-gray-700 border-gray-200 dark:border-gray-800 text-xs break-all" @value={{this.link.linkUrl}}>{{this.link.linkUrl}}</ClickToCopy>
                </InputGroup>

                <InputGroup @name={{t "navigator-app-link.app-link"}} @helpText={{t "navigator-app-link.app-link-help"}}>
                    <ClickToCopy class="block px-4 py-2 border rounded-md bg-gray-100 shadow-sm dark:bg-gray-700 border-gray-200 dark:border-gray-800 text-xs break-all" @value={{this.link.deepLink}}>{{t "navigator-app-link.app-link-copy"}}</ClickToCopy>
                </InputGroup>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs dark:text-gray-300 text-gray-700">
                    <div><span class="font-semibold">{{t "navigator-app-link.server"}}:</span> <span class="font-mono break-all">{{this.link.host}}</span></div>
                    <div><span class="font-semibold">{{t "navigator-app-link.live-updates"}}:</span> <span class="font-mono break-all">{{this.liveUpdates}}</span></div>
                </div>

                <div class="mt-3">
                    <Button @size="xs" @icon="rotate" @text={{t "navigator-app-link.refresh"}} @onClick={{perform this.load}} @isLoading={{this.load.isRunning}} />
                </div>
            </div>
        </div>

        <div class="mt-6 pt-4 border-t border-gray-200 dark:border-gray-700">
            <p class="text-sm dark:text-gray-200 text-gray-800 mb-1 font-semibold">{{t "navigator-app-link.share-title"}}</p>
            <p class="text-xs dark:text-gray-400 text-gray-600 mb-3">{{t "navigator-app-link.share-help"}}</p>

            <InputGroup @name={{t "navigator-app-link.share-drivers"}}>
                <ModelSelect
                    @modelName="driver"
                    @placeholder={{t "navigator-app-link.share-placeholder"}}
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{true}}
                    @renderInPlace={{true}}
                    @onChange={{this.addDriver}}
                    as |driver|
                >
                    <SelectOption::Driver @option={{driver}} />
                </ModelSelect>
            </InputGroup>

            {{#if this.hasSelectedDrivers}}
                <div class="flex flex-wrap gap-2 mb-3">
                    {{#each this.selectedDrivers as |driver|}}
                        <span class="inline-flex items-center px-2 py-1 rounded-md text-xs bg-gray-100 dark:bg-gray-700 dark:text-gray-100 text-gray-800 border border-gray-200 dark:border-gray-600">
                            {{driver.name}}
                            <button type="button" class="ml-2 text-gray-500 hover:text-gray-800 dark:hover:text-white" aria-label={{t "navigator-app-link.remove-driver" name=driver.name}} {{on "click" (fn this.removeDriver driver)}}>
                                <FaIcon @icon="times" @size="xs" />
                            </button>
                        </span>
                    {{/each}}
                </div>
            {{/if}}

            <div class="flex items-center space-x-2">
                <Button
                    @type="primary"
                    @size="sm"
                    @icon="paper-plane"
                    @text={{t "navigator-app-link.send-selected"}}
                    @onClick={{perform this.sendToSelected}}
                    @isLoading={{this.sendToSelected.isRunning}}
                    @disabled={{not this.hasSelectedDrivers}}
                />
                <Button @size="sm" @icon="users" @text={{t "navigator-app-link.send-all"}} @onClick={{perform this.sendToAll}} @isLoading={{this.sendToAll.isRunning}} />
            </div>

            {{#if this.lastShare.failed.length}}
                <div class="mt-3 text-xs dark:text-gray-300 text-gray-700">
                    <p class="font-semibold mb-1">{{t "navigator-app-link.failed-title"}}</p>
                    <ul class="list-disc pl-5 space-y-1">
                        {{#each this.lastShare.failed as |failure|}}
                            <li>{{failure.name}}: {{failure.reason}}</li>
                        {{/each}}
                    </ul>
                </div>
            {{/if}}
        </div>
    {{/if}}
</ContentPanel>
