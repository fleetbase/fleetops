{{#let (or @equipment @resource) as |resource|}}
    <Pill
        @resource={{resource}}
        @imageSrc={{resource.photo_url}}
        @fallbackImageType="placeholderImage"
        @noTooltip={{true}}
        @onClick={{@onClick}}
        @anchorClass={{@anchorClass}}
        @imageClass={{@imageClass}}
        @imageWrapperClass={{@imageWrapperClass}}
        @contentWrapperClass="min-w-0 {{@contentWrapperClass}}"
        ...attributes
    >
        <div class="text-sm truncate {{@titleClass}}">{{or resource.name resource.public_id}}</div>
        <div class="text-xs text-gray-400 dark:text-gray-500 truncate {{@subtitleClass}}">
            {{#if resource.type}}{{smart-humanize resource.type}}{{/if}}
            {{#if (or resource.serial_number resource.code)}}<span class="mx-1">·</span>{{or resource.serial_number resource.code}}{{/if}}
        </div>
    </Pill>
{{/let}}
