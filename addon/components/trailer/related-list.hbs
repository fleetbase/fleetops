<div class="p-4">{{#if this.load.isRunning}}<Spinner />{{else if this.records.length}}<div class="space-y-2">{{#each this.records as |record|}}<div class="flex items-center justify-between border rounded p-3"><div><div class="font-semibold">{{or record.name record.subject record.summary record.public_id}}</div><div class="text-xs text-gray-500">{{record.status}}</div></div><Button @icon="eye" @size="xs" @onClick={{fn this.view record}} /></div>{{/each}}</div>{{else}}<div class="py-10 text-center text-gray-500">{{t "trailer.empty.related"}}</div>{{/if}}</div>
