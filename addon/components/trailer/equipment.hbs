<div class="p-4"><div class="flex justify-end mb-3"><Button @icon="plus" @size="xs" @type="primary" @text={{t "trailer.actions.attach-equipment"}} @onClick={{this.attach}} @permission="fleet-ops attach-equipment-for trailer" /></div>{{#if this.load.isRunning}}<Spinner />{{else if this.equipment.length}}<div class="space-y-2">{{#each this.equipment as |item|}}<div class="flex items-center justify-between border rounded p-3"><div><div class="font-semibold">{{item.name}}</div><div class="text-xs text-gray-500">{{or item.type item.serial_number}}</div></div><div class="flex space-x-2"><Button @icon="eye" @size="xs" @onClick={{fn this.equipmentActions.transition.view item}} /><Button @icon="unlink" @size="xs" @type="danger" @onClick={{fn this.detach item}} @permission="fleet-ops detach-equipment-for trailer" /></div></div>{{/each}}</div>{{else}}<div class="py-10 text-center text-gray-500">{{t "trailer.empty.equipment"}}</div>{{/if}}</div>
