<div class="form-wrapper trailer-form" ...attributes>
    <RegistryYield @registry="fleet-ops:component:trailer:form:start" as |RegistryComponent|>
        <RegistryComponent @resource={{@resource}} @controller={{@controller}} @permission={{get-write-permission @resource}} />
    </RegistryYield>

    {{! DETAILS / IDENTIFICATION }}
    <ContentPanel @title={{t "trailer.sections.details"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="flex flex-row space-x-3 mb-3">
            <div class="flex items-center justify-start rounded-full">
                <Image
                    src={{or @resource.photo_url (config "defaultValues.vehicleImage")}}
                    @fallbackSrc={{config "defaultValues.vehicleImage"}}
                    alt={{@resource.name}}
                    height="48"
                    width="48"
                    class="h-14 w-14 rounded-full shadow-sm"
                />
                <Attach::Tooltip @class="clean" @animation="scale" @placement="top">
                    <InputInfo @text={{t "trailer.help.photo"}} />
                </Attach::Tooltip>
            </div>
            <div>
                <UploadButton
                    @name={{t "trailer.fields.photo"}}
                    @accept="image/*"
                    @onFileAdded={{perform this.handlePhotoUpload}}
                    @icon="upload"
                    @size="xs"
                    @buttonText={{t "common.upload-image"}}
                    @disabled={{cannot-write @resource}}
                />
                <div class="px-1">
                    <span class="text-gray-300 dark:text-gray-600 text-xs">{{t "common.upload-image-supported"}}</span>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-2 lg:grid-cols-2 lg:gap-2 no-input-group-padding text-xs">
            <div class="col-span-1 lg:col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-1">
                {{t "trailer.sections.identification"}}
            </div>

            <InputGroup @name={{t "trailer.fields.name"}} @helpText={{t "trailer.help.name"}}>
                <Input @value={{@resource.name}} @type="text" class="w-full form-input" placeholder={{t "trailer.placeholders.name"}} disabled={{cannot-write @resource}} required />
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.code"}} @helpText={{t "trailer.help.code"}}>
                <Input @value={{@resource.code}} @type="text" class="w-full form-input" placeholder={{t "trailer.placeholders.code"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.description"}} @wrapperClass="col-span-1 lg:col-span-2">
                <Textarea @value={{@resource.description}} class="w-full form-input" rows="2" placeholder={{t "trailer.placeholders.description"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <div class="col-span-1 lg:col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-3">
                {{t "trailer.sections.classification"}}
            </div>

            <InputGroup @name={{t "trailer.fields.type"}} @helpText={{t "trailer.help.type"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{this.typeOptions}}
                        @selected={{find-by "value" @resource.type this.typeOptions}}
                        @onChange={{this.setType}}
                        @placeholder={{t "trailer.placeholders.type"}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        @searchEnabled={{true}}
                        @searchField="label"
                        as |option|
                    >
                        {{option.label}}
                    </PowerSelect>
                </div>
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.status"}} @helpText={{t "trailer.help.status"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{this.statusOptions}}
                        @selected={{find-by "value" @resource.status this.statusOptions}}
                        @onChange={{set-model-attr @resource "status"}}
                        @placeholder={{t "trailer.placeholders.status"}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |option|
                    >
                        <div class="text-sm">
                            <div class="font-semibold normalize-in-trigger">{{option.label}}</div>
                            <div class="hide-from-trigger">{{option.description}}</div>
                        </div>
                    </PowerSelect>
                </div>
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.body-type"}} @helpText={{t "trailer.help.body-type"}}>
                <Input @value={{@resource.body_type}} @type="text" class="w-full form-input" placeholder={{t "trailer.placeholders.body-type"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.color"}}>
                <Input @value={{@resource.color}} @type="text" class="w-full form-input" placeholder={{t "trailer.placeholders.color"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.category"}} @helpText={{t "trailer.help.category"}}>
                <ModelSelect
                    @modelName="category"
                    @selectedModel={{@resource.category}}
                    @query={{hash for="trailer"}}
                    @placeholder={{t "trailer.placeholders.category"}}
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @allowClear={{true}}
                    @onChange={{this.setCategory}}
                    @disabled={{cannot-write @resource}}
                    as |model|
                >
                    {{model.name}}
                </ModelSelect>
            </InputGroup>

            <div class="col-span-1 lg:col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-3">
                {{t "trailer.sections.registration"}}
            </div>

            <InputGroup @name={{t "trailer.fields.vin"}} @helpText={{t "trailer.help.vin"}}>
                <Input @value={{@resource.vin}} @type="text" class="w-full form-input" placeholder={{t "trailer.placeholders.vin"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.plate-number"}}>
                <Input @value={{@resource.plate_number}} @type="text" class="w-full form-input" placeholder={{t "trailer.placeholders.plate-number"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.serial-number"}}>
                <Input @value={{@resource.serial_number}} @type="text" class="w-full form-input" placeholder={{t "trailer.placeholders.serial-number"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.make"}}>
                <Input @value={{@resource.make}} @type="text" class="w-full form-input" placeholder={{t "trailer.placeholders.make"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.model"}}>
                <Input @value={{@resource.model}} @type="text" class="w-full form-input" placeholder={{t "trailer.placeholders.model"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.year"}}>
                <Input @value={{@resource.year}} @type="number" min="1880" step="1" class="w-full form-input" placeholder={{t "trailer.placeholders.year"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <div class="col-span-1 lg:col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-3">
                {{t "trailer.sections.location"}}
            </div>

            <InputGroup @name={{t "trailer.fields.coordinates"}} @wrapperClass="col-span-1 lg:col-span-2" @helpText={{t "trailer.help.coordinates"}}>
                <ModelCoordinatesInput @model={{@resource}} @disabled={{cannot-write @resource}} @autocomplete="location" />
            </InputGroup>
        </div>

        <RegistryYield @registry="fleet-ops:component:trailer:form:details" as |RegistryComponent|>
            <RegistryComponent @resource={{@resource}} @controller={{@controller}} @permission={{get-write-permission @resource}} />
        </RegistryYield>
    </ContentPanel>

    {{! DIMENSIONS & CAPACITY }}
    <ContentPanel @title={{t "trailer.sections.dimensions"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 gap-2 lg:grid-cols-2 lg:gap-2 no-input-group-padding text-xs">
            <div class="col-span-1 lg:col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-1">
                {{t "trailer.sections.measurement"}}
            </div>

            <InputGroup @name={{t "trailer.fields.measurement-system"}} @helpText={{t "trailer.help.measurement-system"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{this.measurementOptions}}
                        @selected={{find-by "value" @resource.measurement_system this.measurementOptions}}
                        @onChange={{set-model-attr @resource "measurement_system"}}
                        @placeholder={{t "trailer.placeholders.measurement-system"}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |option|
                    >
                        <div class="text-sm">
                            <div class="font-semibold normalize-in-trigger">{{option.label}}</div>
                            <div class="hide-from-trigger">{{option.description}}</div>
                        </div>
                    </PowerSelect>
                </div>
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.odometer-unit"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{this.odometerUnitOptions}}
                        @selected={{find-by "value" @resource.odometer_unit this.odometerUnitOptions}}
                        @onChange={{set-model-attr @resource "odometer_unit"}}
                        @placeholder={{t "trailer.placeholders.odometer-unit"}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |option|
                    >
                        {{option.label}}
                    </PowerSelect>
                </div>
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.odometer" unit=(or @resource.odometer_unit "")}} @helpText={{t "trailer.help.odometer"}}>
                <Input @value={{@resource.odometer}} @type="number" min="0" step="1" class="w-full form-input" placeholder={{t "trailer.placeholders.odometer"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <div class="col-span-1 lg:col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-3">
                {{t "trailer.sections.dimensions-fields" unit=this.units.length}}
            </div>

            <InputGroup @name={{t "trailer.fields.length" unit=this.units.length}}>
                <Input @value={{@resource.length}} @type="number" min="0" step="0.001" class="w-full form-input" placeholder={{t "trailer.placeholders.length"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.width" unit=this.units.length}}>
                <Input @value={{@resource.width}} @type="number" min="0" step="0.001" class="w-full form-input" placeholder={{t "trailer.placeholders.width"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.height" unit=this.units.length}}>
                <Input @value={{@resource.height}} @type="number" min="0" step="0.001" class="w-full form-input" placeholder={{t "trailer.placeholders.height"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.cargo-volume" unit=this.units.volume}} @helpText={{t "trailer.help.cargo-volume"}}>
                <Input @value={{@resource.cargo_volume}} @type="number" min="0" step="0.001" class="w-full form-input" placeholder={{t "trailer.placeholders.cargo-volume"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <div class="col-span-1 lg:col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-3">
                {{t "trailer.sections.weight" unit=this.units.weight}}
            </div>

            <InputGroup @name={{t "trailer.fields.tare-weight" unit=this.units.weight}} @helpText={{t "trailer.help.tare-weight"}}>
                <Input @value={{@resource.tare_weight}} @type="number" min="0" step="0.001" class="w-full form-input" placeholder={{t "trailer.placeholders.tare-weight"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.gvwr" unit=this.units.weight}} @helpText={{t "trailer.help.gvwr"}}>
                <Input @value={{@resource.gvwr}} @type="number" min="0" step="0.001" class="w-full form-input" placeholder={{t "trailer.placeholders.gvwr"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.payload-capacity" unit=this.units.weight}} @helpText={{t "trailer.help.payload-capacity"}}>
                <Input @value={{@resource.payload_capacity}} @type="number" min="0" step="0.001" class="w-full form-input" placeholder={{t "trailer.placeholders.payload-capacity"}} disabled={{cannot-write @resource}} />
            </InputGroup>
        </div>
    </ContentPanel>

    {{! RUNNING GEAR }}
    <ContentPanel @title={{t "trailer.sections.running-gear"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 gap-2 lg:grid-cols-2 lg:gap-2 no-input-group-padding text-xs">
            <InputGroup @name={{t "trailer.fields.axle-count"}}>
                <Input @value={{@resource.axle_count}} @type="number" min="0" step="1" class="w-full form-input" placeholder={{t "trailer.placeholders.axle-count"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.tire-count"}}>
                <Input @value={{@resource.tire_count}} @type="number" min="0" step="1" class="w-full form-input" placeholder={{t "trailer.placeholders.tire-count"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.door-count"}}>
                <Input @value={{@resource.door_count}} @type="number" min="0" step="1" class="w-full form-input" placeholder={{t "trailer.placeholders.door-count"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.coupling-type"}} @helpText={{t "trailer.help.coupling-type"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{this.couplingOptions}}
                        @selected={{find-by "value" @resource.coupling_type this.couplingOptions}}
                        @onChange={{set-model-attr @resource "coupling_type"}}
                        @placeholder={{t "trailer.placeholders.coupling-type"}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |option|
                    >
                        {{option.label}}
                    </PowerSelect>
                </div>
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.brake-type"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{this.brakeOptions}}
                        @selected={{find-by "value" @resource.brake_type this.brakeOptions}}
                        @onChange={{set-model-attr @resource "brake_type"}}
                        @placeholder={{t "trailer.placeholders.brake-type"}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |option|
                    >
                        {{option.label}}
                    </PowerSelect>
                </div>
            </InputGroup>

            <div class="grid grid-cols-2 gap-2">
                <InputGroup @name={{t "trailer.fields.abs"}} @helpText={{t "trailer.help.abs"}}>
                    <Toggle @isToggled={{@resource.abs_equipped}} @onToggle={{set-model-attr @resource "abs_equipped"}} @disabled={{cannot-write @resource}} />
                </InputGroup>

                <InputGroup @name={{t "trailer.fields.ebs"}} @helpText={{t "trailer.help.ebs"}}>
                    <Toggle @isToggled={{@resource.ebs_equipped}} @onToggle={{set-model-attr @resource "ebs_equipped"}} @disabled={{cannot-write @resource}} />
                </InputGroup>
            </div>
        </div>
    </ContentPanel>

    {{! REFRIGERATION }}
    <ContentPanel @title={{t "trailer.sections.refrigeration"}} @open={{this.showRefrigeration}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 gap-2 lg:grid-cols-2 lg:gap-2 no-input-group-padding text-xs">
            <InputGroup @name={{t "trailer.fields.refrigerated"}} @helpText={{t "trailer.help.refrigerated"}} @wrapperClass="col-span-1 lg:col-span-2">
                <Toggle @isToggled={{@resource.refrigerated}} @onToggle={{this.toggleRefrigerated}} @disabled={{cannot-write @resource}} />
            </InputGroup>

            {{#if this.showRefrigeration}}
                <InputGroup @name={{t "trailer.fields.temperature-min" unit=this.units.temperature}} @helpText={{t "trailer.help.temperature"}}>
                    <Input @value={{@resource.temperature_min}} @type="number" step="0.1" class="w-full form-input" placeholder={{t "trailer.placeholders.temperature-min"}} disabled={{cannot-write @resource}} />
                </InputGroup>

                <InputGroup @name={{t "trailer.fields.temperature-max" unit=this.units.temperature}}>
                    <Input @value={{@resource.temperature_max}} @type="number" step="0.1" class="w-full form-input" placeholder={{t "trailer.placeholders.temperature-max"}} disabled={{cannot-write @resource}} />
                </InputGroup>

                <InputGroup @name={{t "trailer.fields.reefer-hours"}} @helpText={{t "trailer.help.reefer-hours"}}>
                    <Input @value={{@resource.reefer_engine_hours}} @type="number" min="0" step="0.1" class="w-full form-input" placeholder={{t "trailer.placeholders.reefer-hours"}} disabled={{cannot-write @resource}} />
                </InputGroup>
            {{/if}}
        </div>
    </ContentPanel>

    {{! OWNERSHIP & FINANCE }}
    <ContentPanel @title={{t "trailer.sections.ownership"}} @open={{false}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 gap-2 lg:grid-cols-2 lg:gap-2 no-input-group-padding text-xs">
            <InputGroup @name={{t "trailer.fields.ownership-type"}} @helpText={{t "trailer.help.ownership-type"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{this.ownershipOptions}}
                        @selected={{find-by "value" @resource.ownership_type this.ownershipOptions}}
                        @onChange={{set-model-attr @resource "ownership_type"}}
                        @placeholder={{t "trailer.placeholders.ownership-type"}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |option|
                    >
                        {{option.label}}
                    </PowerSelect>
                </div>
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.financing-status"}}>
                <Input @value={{@resource.financing_status}} @type="text" class="w-full form-input" placeholder={{t "trailer.placeholders.financing-status"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.vendor"}} @helpText={{t "trailer.help.vendor"}}>
                <ModelSelect
                    @modelName="vendor"
                    @selectedModel={{@resource.vendor}}
                    @placeholder={{t "trailer.placeholders.vendor"}}
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @allowClear={{true}}
                    @onChange={{this.setVendor}}
                    @disabled={{cannot-write @resource}}
                    as |model|
                >
                    {{model.name}}
                </ModelSelect>
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.warranty"}} @helpText={{t "trailer.help.warranty"}}>
                <ModelSelect
                    @modelName="warranty"
                    @selectedModel={{@resource.warranty}}
                    @placeholder={{t "trailer.placeholders.warranty"}}
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @allowClear={{true}}
                    @onChange={{this.setWarranty}}
                    @disabled={{cannot-write @resource}}
                    as |model|
                >
                    {{or model.name (concat model.policy_number " - " model.provider)}}
                </ModelSelect>
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.purchased-at"}}>
                <DatePicker
                    @value={{or (format-date-fns @resource.purchased_at "dd-MM-yyyy") null}}
                    @onChange={{fn (mut @resource.purchased_at)}}
                    @placeholder={{t "trailer.placeholders.date"}}
                    @disabled={{cannot-write @resource}}
                    class="filter-date-input w-full flex-1"
                />
            </InputGroup>

            {{#if this.showLeaseExpiry}}
                <InputGroup @name={{t "trailer.fields.lease-expires-at"}} @helpText={{t "trailer.help.lease-expires-at"}}>
                    <DatePicker
                        @value={{or (format-date-fns @resource.lease_expires_at "dd-MM-yyyy") null}}
                        @onChange={{fn (mut @resource.lease_expires_at)}}
                        @placeholder={{t "trailer.placeholders.date"}}
                        @disabled={{cannot-write @resource}}
                        class="filter-date-input w-full flex-1"
                    />
                </InputGroup>
            {{/if}}

            <div class="col-span-1 lg:col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-3">
                {{t "trailer.sections.finance"}}
            </div>

            <InputGroup @name={{t "trailer.fields.currency"}}>
                <CurrencySelect @currency={{this.currency}} @onCurrencyChange={{fn (mut @resource.currency)}} @triggerClass="w-full form-select" @disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.acquisition-cost"}} @helpText={{t "trailer.help.acquisition-cost"}}>
                <MoneyInput class="w-full" @value={{@resource.acquisition_cost}} @currency={{this.currency}} @onChange={{fn (mut @resource.acquisition_cost)}} @disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.current-value"}}>
                <MoneyInput class="w-full" @value={{@resource.current_value}} @currency={{this.currency}} @onChange={{fn (mut @resource.current_value)}} @disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.insurance-value"}}>
                <MoneyInput class="w-full" @value={{@resource.insurance_value}} @currency={{this.currency}} @onChange={{fn (mut @resource.insurance_value)}} @disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "trailer.fields.depreciation-rate"}} @helpText={{t "trailer.help.depreciation-rate"}}>
                <Input @value={{@resource.depreciation_rate}} @type="number" min="0" max="100" step="0.01" class="w-full form-input" placeholder={{t "trailer.placeholders.depreciation-rate"}} disabled={{cannot-write @resource}} />
            </InputGroup>
        </div>
    </ContentPanel>

    {{! NOTES }}
    <ContentPanel @title={{t "trailer.sections.notes"}} @open={{false}} @wrapperClass="bordered-top">
        <InputGroup @name={{t "trailer.fields.notes"}} @wrapperClass="no-input-group-padding">
            <Textarea @value={{@resource.notes}} class="w-full form-input" rows="4" placeholder={{t "trailer.placeholders.notes"}} disabled={{cannot-write @resource}} />
        </InputGroup>
    </ContentPanel>

    <CustomField::Yield @subject={{@resource}} @wrapperClass="bordered-top" />

    <RegistryYield @registry="fleet-ops:component:trailer:form:end" as |RegistryComponent|>
        <RegistryComponent @resource={{@resource}} @controller={{@controller}} @permission={{get-write-permission @resource}} />
    </RegistryYield>
</div>
