<div class="form-wrapper" ...attributes>
    <RegistryYield @registry="fleet-ops:component:trailer:form:start" as |RegistryComponent|><RegistryComponent @resource={{@resource}} @controller={{@controller}} @permission={{get-write-permission @resource}} /></RegistryYield>
    <ContentPanel @title={{t "trailer.sections.identity"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="flex items-center space-x-3 mb-3"><Image src={{@resource.photo_url}} @fallbackSrc={{config "defaultValues.vehicleImage"}} alt={{@resource.name}} class="h-14 w-14 rounded-full" /><UploadButton @name={{t "common.photos"}} @accept="image/*" @onFileAdded={{perform this.handlePhotoUpload}} @icon="upload" @size="xs" @buttonText={{t "common.upload-image"}} @disabled={{cannot-write @resource}} /></div>
        <div class="grid grid-cols-1 gap-2 lg:grid-cols-2 text-xs">
            <InputGroup @name={{t "common.name"}}><Input @value={{@resource.name}} class="w-full form-input" disabled={{cannot-write @resource}} /></InputGroup>
            <InputGroup @name={{t "trailer.fields.code"}}><Input @value={{@resource.code}} class="w-full form-input" disabled={{cannot-write @resource}} /></InputGroup>
            <InputGroup @name={{t "trailer.fields.description"}} @wrapperClass="lg:col-span-2"><Textarea @value={{@resource.description}} class="w-full form-input" disabled={{cannot-write @resource}} /></InputGroup>
            <InputGroup @name={{t "trailer.fields.type"}}><PowerSelect @options={{this.typeOptions}} @selected={{find-by "value" @resource.type this.typeOptions}} @onChange={{set-model-attr @resource "type"}} @placeholder={{t "trailer.placeholders.type"}} @triggerClass="form-select form-input" @disabled={{cannot-write @resource}} as |option|>{{option.label}}</PowerSelect></InputGroup>
            <InputGroup @name={{t "common.status"}}><PowerSelect @options={{this.statusOptions}} @selected={{find-by "value" @resource.status this.statusOptions}} @onChange={{set-model-attr @resource "status"}} @triggerClass="form-select form-input" @disabled={{cannot-write @resource}} as |option|>{{option.label}}</PowerSelect></InputGroup>
            <InputGroup @name={{t "trailer.fields.body-type"}}><Input @value={{@resource.body_type}} class="w-full form-input" /></InputGroup>
            <InputGroup @name={{t "trailer.fields.color"}}><Input @value={{@resource.color}} class="w-full form-input" /></InputGroup>
        </div>
    </ContentPanel>
    <ContentPanel @title={{t "trailer.sections.registration"}} @open={{true}} @wrapperClass="bordered-top"><div class="grid grid-cols-1 gap-2 lg:grid-cols-2 text-xs">
        <InputGroup @name={{t "trailer.fields.vin"}}><Input @value={{@resource.vin}} class="w-full form-input" /></InputGroup><InputGroup @name={{t "column.plate-number"}}><Input @value={{@resource.plate_number}} class="w-full form-input" /></InputGroup>
        <InputGroup @name={{t "trailer.fields.serial-number"}}><Input @value={{@resource.serial_number}} class="w-full form-input" /></InputGroup><InputGroup @name={{t "column.make"}}><Input @value={{@resource.make}} class="w-full form-input" /></InputGroup>
        <InputGroup @name={{t "column.model"}}><Input @value={{@resource.model}} class="w-full form-input" /></InputGroup><InputGroup @name={{t "column.year"}}><Input @value={{@resource.year}} @type="number" class="w-full form-input" /></InputGroup>
    </div></ContentPanel>
    <ContentPanel @title={{t "trailer.sections.dimensions"}} @open={{true}} @wrapperClass="bordered-top"><div class="grid grid-cols-1 gap-2 lg:grid-cols-3 text-xs">
        <InputGroup @name={{t "trailer.fields.length"}}><Input @value={{@resource.length}} @type="number" class="w-full form-input" /></InputGroup><InputGroup @name={{t "trailer.fields.width"}}><Input @value={{@resource.width}} @type="number" class="w-full form-input" /></InputGroup><InputGroup @name={{t "trailer.fields.height"}}><Input @value={{@resource.height}} @type="number" class="w-full form-input" /></InputGroup>
        <InputGroup @name={{t "trailer.fields.tare"}}><Input @value={{@resource.tare_weight}} @type="number" class="w-full form-input" /></InputGroup><InputGroup @name={{t "trailer.fields.gvwr"}}><Input @value={{@resource.gvwr}} @type="number" class="w-full form-input" /></InputGroup><InputGroup @name={{t "trailer.fields.payload"}}><Input @value={{@resource.payload_capacity}} @type="number" class="w-full form-input" /></InputGroup>
        <InputGroup @name={{t "trailer.fields.cargo-volume"}}><Input @value={{@resource.cargo_volume}} @type="number" class="w-full form-input" /></InputGroup><InputGroup @name={{t "trailer.fields.measurement"}}><PowerSelect @options={{this.measurementOptions}} @selected={{find-by "value" @resource.measurement_system this.measurementOptions}} @onChange={{set-model-attr @resource "measurement_system"}} @triggerClass="form-select form-input" as |option|>{{option.label}}</PowerSelect></InputGroup><InputGroup @name={{t "trailer.fields.hubometer"}}><Input @value={{@resource.odometer}} @type="number" class="w-full form-input" /></InputGroup>
    </div></ContentPanel>
    <ContentPanel @title={{t "trailer.sections.running-gear"}} @open={{true}} @wrapperClass="bordered-top"><div class="grid grid-cols-1 gap-2 lg:grid-cols-2 text-xs">
        <InputGroup @name={{t "trailer.fields.axles"}}><Input @value={{@resource.axle_count}} @type="number" class="w-full form-input" /></InputGroup><InputGroup @name={{t "trailer.fields.tires"}}><Input @value={{@resource.tire_count}} @type="number" class="w-full form-input" /></InputGroup>
        <InputGroup @name={{t "trailer.fields.coupling"}}><Input @value={{@resource.coupling_type}} class="w-full form-input" /></InputGroup><InputGroup @name={{t "trailer.fields.brakes"}}><Input @value={{@resource.brake_type}} class="w-full form-input" /></InputGroup>
        <InputGroup @name={{t "trailer.fields.abs"}}><Toggle @isToggled={{@resource.abs_equipped}} @onToggle={{set-model-attr @resource "abs_equipped"}} /></InputGroup><InputGroup @name={{t "trailer.fields.ebs"}}><Toggle @isToggled={{@resource.ebs_equipped}} @onToggle={{set-model-attr @resource "ebs_equipped"}} /></InputGroup>
    </div></ContentPanel>
    <ContentPanel @title={{t "trailer.sections.refrigeration"}} @open={{false}} @wrapperClass="bordered-top"><div class="grid grid-cols-1 gap-2 lg:grid-cols-2 text-xs">
        <InputGroup @name={{t "trailer.fields.refrigerated"}}><Toggle @isToggled={{@resource.refrigerated}} @onToggle={{set-model-attr @resource "refrigerated"}} /></InputGroup><InputGroup @name={{t "trailer.fields.doors"}}><Input @value={{@resource.door_count}} @type="number" class="w-full form-input" /></InputGroup>
        <InputGroup @name={{t "trailer.fields.temperature-min"}}><Input @value={{@resource.temperature_min}} @type="number" class="w-full form-input" /></InputGroup><InputGroup @name={{t "trailer.fields.temperature-max"}}><Input @value={{@resource.temperature_max}} @type="number" class="w-full form-input" /></InputGroup><InputGroup @name={{t "trailer.fields.reefer-hours"}}><Input @value={{@resource.reefer_engine_hours}} @type="number" class="w-full form-input" /></InputGroup>
    </div></ContentPanel>
    <ContentPanel @title={{t "trailer.sections.ownership"}} @open={{false}} @wrapperClass="bordered-top"><div class="grid grid-cols-1 gap-2 lg:grid-cols-2 text-xs">
        <InputGroup @name={{t "trailer.fields.ownership"}}><Input @value={{@resource.ownership_type}} class="w-full form-input" /></InputGroup><InputGroup @name={{t "trailer.fields.currency"}}><Input @value={{@resource.currency}} class="w-full form-input" /></InputGroup>
        <InputGroup @name={{t "trailer.fields.purchase-date"}}><Input @value={{@resource.purchased_at}} @type="date" class="w-full form-input" /></InputGroup><InputGroup @name={{t "trailer.fields.lease-expiry"}}><Input @value={{@resource.lease_expires_at}} @type="date" class="w-full form-input" /></InputGroup>
        <InputGroup @name={{t "trailer.fields.acquisition-cost"}}><Input @value={{@resource.acquisition_cost}} @type="number" class="w-full form-input" /></InputGroup><InputGroup @name={{t "trailer.fields.current-value"}}><Input @value={{@resource.current_value}} @type="number" class="w-full form-input" /></InputGroup>
        <InputGroup @name={{t "trailer.fields.vendor"}}><ModelSelect @modelName="vendor" @selectedModel={{@resource.vendor}} @onChange={{set-model-attr @resource "vendor"}} @triggerClass="form-select form-input" as |vendor|>{{vendor.name}}</ModelSelect></InputGroup><InputGroup @name={{t "trailer.fields.warranty"}}><ModelSelect @modelName="warranty" @selectedModel={{@resource.warranty}} @onChange={{set-model-attr @resource "warranty"}} @triggerClass="form-select form-input" as |warranty|>{{warranty.name}}</ModelSelect></InputGroup>
    </div></ContentPanel>
    <ContentPanel @title={{t "common.notes"}} @open={{false}} @wrapperClass="bordered-top"><Textarea @value={{@resource.notes}} class="w-full form-input" /><InputGroup @name={{t "common.coordinates"}}><ModelCoordinatesInput @model={{@resource}} @disabled={{cannot-write @resource}} @autocomplete="location" /></InputGroup></ContentPanel>
    <CustomField::Yield @subject={{@resource}} @wrapperClass="bordered-top" />
    <RegistryYield @registry="fleet-ops:component:trailer:form:end" as |RegistryComponent|><RegistryComponent @resource={{@resource}} @controller={{@controller}} /></RegistryYield>
</div>
