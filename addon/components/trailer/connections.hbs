<div class="p-4"><h3 class="font-semibold mb-3">{{t "trailer.tabs.connections"}}</h3>{{#if @resource.connections.length}}<table class="min-w-full text-xs"><thead><tr><th class="text-left py-2">{{t "trailer.fields.vehicle"}}</th><th class="text-left py-2">{{t "trailer.fields.connected-at"}}</th><th class="text-left py-2">{{t "trailer.fields.disconnected-at"}}</th><th class="text-left py-2">{{t "common.status"}}</th></tr></thead><tbody>{{#each @resource.connections as |connection|}}<tr class="border-t"><td class="py-2">{{n-a connection.vehicle.name}}</td><td>{{n-a connection.connected_at}}</td><td>{{n-a connection.disconnected_at}}</td><td><StatusBadge @status={{if connection.active "attached" "detached"}} /></td></tr>{{/each}}</tbody></table>{{else}}<div class="py-10 text-center text-gray-500">{{t "trailer.empty.connections"}}</div>{{/if}}</div>
