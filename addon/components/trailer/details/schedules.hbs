<div class="trailer-details-schedules p-4">
    <div class="flex flex-row items-center justify-end mb-3">
        <Button @icon="plus" @text={{t "trailer.actions.schedule-maintenance"}} @size="xs" @type="primary" @onClick={{this.createSchedule}} @permission="fleet-ops create maintenance-schedule" />
    </div>

    {{#if this.loadSchedules.isRunning}}
        <div class="flex items-center justify-center py-10">
            <Spinner />
        </div>
    {{else if this.schedules.length}}
        <div class="overflow-x-auto">
            <table class="min-w-full text-xs">
                <thead>
                    <tr class="border-b border-gray-200 dark:border-gray-700">
                        <th class="text-left py-2 pr-4 font-semibold text-gray-500 uppercase tracking-wide">{{t "common.name"}}</th>
                        <th class="text-left py-2 pr-4 font-semibold text-gray-500 uppercase tracking-wide">{{t "trailer.maintenance.interval"}}</th>
                        <th class="text-left py-2 pr-4 font-semibold text-gray-500 uppercase tracking-wide">{{t "trailer.maintenance.next-due"}}</th>
                        <th class="text-left py-2 pr-4 font-semibold text-gray-500 uppercase tracking-wide">{{t "common.status"}}</th>
                        <th class="py-2"></th>
                    </tr>
                </thead>
                <tbody>
                    {{#each this.schedules as |schedule|}}
                        <tr class="border-b border-gray-100 dark:border-gray-800 hover:bg-gray-50 dark:hover:bg-gray-800">
                            <td class="py-2 pr-4 font-medium">{{schedule.name}}</td>
                            <td class="py-2 pr-4 text-gray-500">{{schedule.interval_value}} {{schedule.interval_unit}}</td>
                            <td class="py-2 pr-4 text-gray-500">{{n-a (format-date-fns schedule.next_due_date "dd MMM yyyy")}}</td>
                            <td class="py-2 pr-4"><Badge @status={{schedule.status}} /></td>
                            <td class="py-2 text-right">
                                <Button @icon="eye" @size="xs" @helpText={{t "common.view"}} @onClick={{fn this.maintenanceScheduleActions.transition.view schedule}} />
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    {{else}}
        <div class="flex flex-col items-center justify-center py-10 text-gray-400 dark:text-gray-600">
            <FaIcon @icon="calendar-check" @size="2x" class="mb-3" />
            <p class="text-sm font-semibold text-gray-600 dark:text-gray-300">{{t "trailer.empty.schedules"}}</p>
            <p class="text-xs">{{t "trailer.empty.schedules-description"}}</p>
            <Button @text={{t "trailer.actions.schedule-maintenance"}} @icon="plus" @size="xs" @type="primary" class="mt-3" @onClick={{this.createSchedule}} @permission="fleet-ops create maintenance-schedule" />
        </div>
    {{/if}}
</div>
