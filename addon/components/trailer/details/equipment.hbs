<AttachmentList
    @title={{t "trailer.tabs.equipment"}}
    @description={{t "trailer.equipment.description"}}
    @actionText={{t "trailer.actions.attach-equipment"}}
    @actionIcon="plus"
    @onAction={{this.attach}}
    @actionPermission="fleet-ops attach-equipment-for trailer"
    @isLoading={{this.loadEquipment.isRunning}}
    @items={{this.equipment}}
    @emptyIcon="toolbox"
    @emptyTitle={{t "trailer.empty.equipment"}}
    @emptyDescription={{t "trailer.empty.equipment-description"}}
    class="trailer-details-equipment"
>
    <:item as |item|>
        <Equipment::Pill @equipment={{item}} @onClick={{fn this.view item}} />
        {{#if item.status}}
            <Badge @status={{item.status}} @size="xs" class="fleetops-attachment-list-item-badge" />
        {{/if}}
    </:item>
    <:itemActions as |item|>
        <Button @icon="eye" @size="xs" @helpText={{t "common.view"}} @onClick={{fn this.view item}} @permission="fleet-ops view equipment" />
        <Button @icon="unlink" @size="xs" @type="danger" @helpText={{t "trailer.actions.detach-equipment"}} @onClick={{fn this.detach item}} @permission="fleet-ops detach-equipment-for trailer" />
    </:itemActions>
</AttachmentList>
