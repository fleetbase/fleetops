<Layout::Resource::Card class="fleetops-resource-card trailer-card" ...attributes as |Card|>
    <Card.header class={{@headerClass}}>
        <RegistryYield @registry="fleet-ops:component:trailer:card:header:start" as |RegistryComponent|>
            <RegistryComponent @resource={{@resource}} />
        </RegistryYield>
        <div class="fleetops-card-title">
            <div class="font-semibold flex-1 truncate">{{@resource.displayName}}</div>
            <FaIcon @icon="circle" @size="xs" class="fleetops-card-title-indicator {{if @resource.online 'text-green-500' 'text-gray-400'}}" />
        </div>
        <div class="text-gray-400 dark:text-gray-500 text-sm w-full truncate">
            {{#if @resource.type}}{{t (concat "trailer.types." @resource.type)}}{{/if}}
            {{#if (or @resource.plate_number @resource.vin @resource.code)}}<span class="mx-1">·</span>{{or @resource.plate_number @resource.vin @resource.code}}{{/if}}
        </div>
        {{#if (has-block "header")}}
            {{yield to="header"}}
        {{/if}}
        <RegistryYield @registry="fleet-ops:component:trailer:card:header:end" as |RegistryComponent|>
            <RegistryComponent @resource={{@resource}} />
        </RegistryYield>
    </Card.header>
    <Card.body class="{{@bodyClass}} h-40 overflow-hidden">
        <Image src={{or @resource.photo_url (trailer-placeholder-image)}} @fallbackSrc={{(trailer-placeholder-image)}} alt={{@resource.displayName}} class="fleetops-card-image fleetops-card-image--contain" />
        {{#if (has-block "body")}}
            {{yield to="body"}}
        {{/if}}
    </Card.body>
    <Card.footer class={{@footerClass}}>
        <RegistryYield @registry="fleet-ops:component:trailer:card:footer:start" as |RegistryComponent|>
            <RegistryComponent @resource={{@resource}} />
        </RegistryYield>
        <div class="flex flex-row items-center justify-between w-full">
            <Badge @status={{or @resource.status "available"}} @size="xs" @text={{t (concat "trailer.statuses." (or @resource.status "available"))}} />
            <div class="flex flex-row items-center space-x-1">
                <Button @icon="eye" @size="xs" @helpText={{t "common.view"}} @onClick={{fn this.trailerActions.transition.view @resource}} @permission="fleet-ops view trailer" />
                <Button @icon="pencil" @size="xs" @helpText={{t "common.edit"}} @onClick={{fn this.trailerActions.transition.edit @resource}} @permission="fleet-ops update trailer" />
                <Button @icon="trash" @size="xs" @type="danger" @helpText={{t "common.delete"}} @onClick={{fn this.trailerActions.delete @resource}} @permission="fleet-ops delete trailer" />
            </div>
        </div>
        <RegistryYield @registry="fleet-ops:component:trailer:card:footer:end" as |RegistryComponent|>
            <RegistryComponent @resource={{@resource}} />
        </RegistryYield>
        {{#if (has-block "footer")}}
            {{yield to="footer"}}
        {{/if}}
        <div class="fleetops-card-meta-list">
            <div class="fleetops-card-meta">
                <FaIcon @icon="car" @prefix="fas" />
                <span class="fleetops-card-meta-value">
                    {{#if @resource.isAttached}}
                        {{#if @resource.current_vehicle}}
                            <a href="javascript:;" class="fleetops-card-meta-link" {{on "click" this.viewVehicle}}>{{n-a @resource.current_vehicle_name}}</a>
                        {{else}}
                            {{n-a @resource.current_vehicle_name}}
                        {{/if}}
                    {{else}}
                        {{t "trailer.attachment.no-vehicle"}}
                    {{/if}}
                </span>
            </div>
            <div class="fleetops-card-meta">
                <FaIcon @icon="satellite-dish" @prefix="fas" />
                <span class="fleetops-card-meta-value">{{t (concat "trailer.connectivity." (or @resource.connectivity_status "never_connected"))}}</span>
            </div>
            <div class="fleetops-card-meta">{{t "common.last-modified"}}: {{@resource.updatedAt}}</div>
        </div>
    </Card.footer>
</Layout::Resource::Card>
{{yield}}
