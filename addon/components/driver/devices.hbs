{{#if this.loaded}}
    <ContentPanel @title={{t "driver-devices.title"}} @open={{true}} @wrapperClass="bordered-top">
        {{#if this.devices.length}}
            <div class="space-y-2 text-xs dark:text-gray-100">
                {{#each this.rows as |device|}}
                    <div class="rounded-md border border-gray-200 dark:border-gray-700 px-3 py-2">
                        <div class="flex items-center justify-between gap-3">
                            <div class="min-w-0">
                                <div class="font-semibold truncate">{{device.heading}}</div>
                                {{#if device.detail}}
                                    <div class="mt-0.5 text-gray-500 dark:text-gray-400 truncate">{{device.detail}}</div>
                                {{/if}}
                                <div class="mt-1 flex items-center flex-wrap gap-2">
                                    <Badge @status={{device.statusColor}} @hideStatusDot={{true}}>{{device.statusLabel}}</Badge>
                                    {{#if device.isDevelopment}}
                                        <Badge @status="warning" @hideStatusDot={{true}}>{{t "driver-devices.development-build"}}</Badge>
                                    {{/if}}
                                    {{#if device.last_seen_at}}
                                        <span class="text-gray-500 dark:text-gray-400">{{t "driver-devices.last-seen" date=(format-date-fns device.last_seen_at "yyyy-MM-dd HH:mm")}}</span>
                                    {{/if}}
                                </div>
                            </div>
                            {{#if device.can_push}}
                                <div class="shrink-0">
                                    <Button @size="xs" @icon="bell" @text={{t "driver-devices.notify"}} @onClick={{fn this.compose device}} @permission="fleet-ops update driver" />
                                </div>
                            {{/if}}
                        </div>
                    </div>
                {{/each}}
            </div>
            {{#if this.composing}}
                <div class="mt-3 rounded-md border border-gray-200 dark:border-gray-700 p-3">
                    <InputGroup @name={{t "driver-devices.message-title"}}>
                        <Input class="form-input w-full" maxlength="120" placeholder={{t "driver-devices.message-title-placeholder"}} @value={{this.title}} />
                    </InputGroup>
                    <InputGroup @name={{t "driver-devices.message-body"}} @helpText={{if this.target (t "driver-devices.to-one-device") (t "driver-devices.to-all-devices")}}>
                        <Textarea class="form-input w-full" rows="3" maxlength="500" placeholder={{t "driver-devices.message-body-placeholder"}} @value={{this.message}} />
                    </InputGroup>
                    <div class="flex items-center gap-2">
                        <Button @size="xs" @type="primary" @icon="paper-plane" @text={{t "driver-devices.send"}} @onClick={{perform this.send}} @isLoading={{this.send.isRunning}} @disabled={{this.cannotSend}} />
                        <Button @size="xs" @text={{t "common.cancel"}} @onClick={{this.cancel}} />
                    </div>
                </div>
            {{else if this.canPushAny}}
                <div class="mt-3">
                    <Button @size="xs" @icon="bell" @text={{t "driver-devices.notify-all"}} @onClick={{fn this.compose null}} @permission="fleet-ops update driver" />
                </div>
            {{/if}}
        {{else}}
            <div class="text-xs text-gray-500 dark:text-gray-400">{{t "driver-devices.none"}}</div>
        {{/if}}
    </ContentPanel>
{{/if}}
