<div class="space-y-6">
    <InfoBlock @type="info" @icon="circle-info" class="mb-4">
        Configure telematics retention policy and activity logging for all organizations. Organizations can choose device event and position history retention within these limits from Fleet-Ops &rsaquo; Settings &rsaquo; Telematics.
        A maximum takes precedence over organization preferences, inherited defaults and requests to keep history forever. Reducing a maximum can delete existing history at the next cleanup.
    </InfoBlock>

    <ContentPanel @title="System Device Events Retention Policy" @open={{true}} @wrapperClass="bordered-classic">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <InputGroup @name="Default Device Event Retention (days)" @helpText="Retention for organizations that inherit the system default. 0 keeps history forever, subject to the maximum below.">
                <Input @type="number" @value={{this.eventRetentionDays}} min="0" max="3650" class="form-input w-full" />
            </InputGroup>
            <InputGroup @name="Maximum Device Event Retention (days)" @helpText="The longest any organization can keep device events. 0 sets no maximum and allows organizations to keep history forever.">
                <Input @type="number" @value={{this.maxEventRetentionDays}} min="0" max="3650" class="form-input w-full" />
            </InputGroup>
        </div>
    </ContentPanel>

    <ContentPanel @title="System Position History Retention Policy" @open={{true}} @wrapperClass="bordered-classic">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <InputGroup @name="Default Position History Retention (days)" @helpText="Retention for organizations that inherit the system default. 0 keeps history forever, subject to the maximum below.">
                <Input @type="number" @value={{this.positionRetentionDays}} min="0" max="3650" class="form-input w-full" />
            </InputGroup>
            <InputGroup @name="Maximum Position History Retention (days)" @helpText="The longest any organization can keep vehicle and trailer positions. 0 sets no maximum and allows organizations to keep history forever.">
                <Input @type="number" @value={{this.maxPositionRetentionDays}} min="0" max="3650" class="form-input w-full" />
            </InputGroup>
        </div>
    </ContentPanel>

    <ContentPanel @title="System Device Event Raw Payload Retention" @open={{true}} @wrapperClass="bordered-classic">
        <InputGroup @name="Device Event Raw Payload Retention (days)" @helpText="Remove raw provider payloads from retained device events across all organizations after this many days. 0 disables compaction. This does not change how long the event history itself is kept.">
            <Input @type="number" @value={{this.eventCompactAfterDays}} min="0" max="3650" class="form-input w-full" />
        </InputGroup>
    </ContentPanel>

    <ContentPanel @title="System Delivery Inbox and Sync Run Retention Policy" @open={{true}} @wrapperClass="bordered-classic">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <InputGroup @name="Processed Delivery Retention (hours)" @helpText="Delete processed delivery envelopes across all organizations after this many hours. 0 keeps them forever.">
                <Input @type="number" @value={{this.processedRetentionHours}} min="0" max="720" class="form-input w-full" />
            </InputGroup>
            <InputGroup @name="Quarantined Delivery Retention (days)" @helpText="Delete quarantined delivery envelopes across all organizations after this many days. 0 keeps them forever.">
                <Input @type="number" @value={{this.quarantineRetentionDays}} min="0" max="365" class="form-input w-full" />
            </InputGroup>
            <InputGroup @name="Sync Run Diagnostics Retention (days)" @helpText="Delete finished sync run diagnostics across all organizations after this many days. 0 keeps them forever.">
                <Input @type="number" @value={{this.syncRunRetentionDays}} min="0" max="365" class="form-input w-full" />
            </InputGroup>
        </div>
    </ContentPanel>

    <ContentPanel @title="System Telemetry Activity Logging" @open={{true}} @wrapperClass="bordered-classic">
        <Toggle
            @label="Log Telemetry Activity"
            @helpText="Write telemetry-driven device, event and vehicle saves to the activity log for all organizations. Every poll can add several activity rows per device."
            @isToggled={{this.logTelemetryActivity}}
            @onToggle={{fn (mut this.logTelemetryActivity)}}
        />
    </ContentPanel>

    <div class="flex justify-end">
        <Button
            @type="primary"
            @size="sm"
            @icon="save"
            @text="Save System Policy"
            @onClick={{perform this.saveSettings}}
            @disabled={{or this.saveSettings.isRunning this.loadSettings.isRunning (not this.settingsLoaded)}}
            @isLoading={{or this.saveSettings.isRunning this.loadSettings.isRunning}}
        />
    </div>

    <ContentPanel @title={{t "settings.telematics.storage-usage"}} @open={{true}} @wrapperClass="bordered-classic">
        <p class="mb-3 text-sm text-gray-600 dark:text-gray-300">
            Storage usage includes telematics data across all organizations. Cleanup applies system-wide, using the saved system policy and each organization's history preferences within that policy.
        </p>
        <div class="flex items-center justify-end gap-2 mb-3">
            <Button
                @size="xs"
                @icon="rotate"
                @text={{t "settings.telematics.refresh"}}
                @onClick={{perform this.loadUsage}}
                @disabled={{this.loadUsage.isRunning}}
                @isLoading={{this.loadUsage.isRunning}}
            />
            <Button
                @type="danger"
                @size="xs"
                @icon="broom"
                @text={{t "settings.telematics.run-cleanup"}}
                @onClick={{this.confirmRunCleanup}}
                @disabled={{or this.runCleanup.isRunning this.loadSettings.isRunning this.saveSettings.isRunning (not this.settingsLoaded)}}
                @isLoading={{this.runCleanup.isRunning}}
            />
        </div>
        {{#if this.usageRows.length}}
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-xs uppercase text-gray-500 dark:text-gray-400">
                            <th class="py-2 pr-3">{{t "settings.telematics.table"}}</th>
                            <th class="py-2 pr-3 text-right">{{t "settings.telematics.rows"}}</th>
                            <th class="py-2 pr-3 text-right">{{t "settings.telematics.estimated-size"}}</th>
                            <th class="py-2 pl-6 text-right whitespace-nowrap">{{t "settings.telematics.oldest"}}</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                        {{#each this.usageRows as |row|}}
                            <tr class="text-gray-800 dark:text-gray-100">
                                <td class="py-2 pr-3">
                                    <div class="font-medium">{{row.label}}</div>
                                    {{#if row.raw_payload_rows}}
                                        <div class="text-xs text-gray-500 dark:text-gray-400">
                                            {{t "settings.telematics.raw-payload-rows" count=(format-number row.raw_payload_rows) compactable=(format-number row.compactable_rows)}}
                                        </div>
                                    {{/if}}
                                </td>
                                <td class="py-2 pr-3 text-right">
                                    {{#if (eq row.rows null)}}
                                        {{t "settings.telematics.not-available"}}
                                    {{else if row.rows_estimated}}
                                        {{t "settings.telematics.estimated-rows" count=(format-number row.rows)}}
                                    {{else}}
                                        {{format-number row.rows}}
                                    {{/if}}
                                </td>
                                <td class="py-2 pr-3 text-right">{{#if (or row.estimated_bytes (eq row.estimated_bytes 0))}}{{format-bytes row.estimated_bytes}}{{else}}{{t "settings.telematics.not-available"}}{{/if}}</td>
                                <td class="py-2 pl-6 text-right text-xs whitespace-nowrap">{{#if row.oldest}}{{row.oldest}}{{else}}{{t "settings.telematics.not-available"}}{{/if}}</td>
                            </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">{{t "settings.telematics.space-reclaim-note"}}</p>
        {{else if this.loadUsage.isRunning}}
            <div class="flex items-center justify-center py-8">
                <Spinner />
            </div>
        {{else}}
            <div class="text-center py-8 text-sm text-gray-400 dark:text-gray-500">
                {{t "settings.telematics.usage-unavailable"}}
            </div>
        {{/if}}
    </ContentPanel>
    <Spacer @height="200px" />
</div>
