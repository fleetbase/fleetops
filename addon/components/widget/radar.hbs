<div class="fleet-ops-widget fleet-ops-kpi-tile fleet-ops-kpi-tile-pop {{this.accentClass}} relative flex flex-col h-full rounded-md border shadow-sm overflow-hidden" data-test-radar-widget ...attributes>
    <div class="flex items-center justify-between px-2.5 pt-2 relative z-10">
        <span class="text-[10px] uppercase tracking-wider text-gray-500 dark:text-gray-400 font-bold truncate">{{t "widget.radar.title"}}</span>
        <FaIcon @icon="satellite-dish" class="kpi-tile-icon text-gray-400 dark:text-gray-500 text-[11px]" />
    </div>
    <div class="flex-1 flex flex-col px-2.5 pt-1 pb-2 min-h-0 relative z-10">
        {{#if this.load.isRunning}}
            <div class="flex-1 flex items-center justify-center"><Spinner /></div>
        {{else if this.error}}
            <div class="flex-1 flex items-center justify-center text-[10px] text-red-500 dark:text-red-400">{{this.error}}</div>
        {{else}}
            <div class="flex items-baseline gap-1.5">
                <span class="text-2xl font-bold leading-none {{this.valueClass}}" data-test-radar-widget-open>{{this.stats.open}}</span>
                <span class="text-[10px] text-gray-500 dark:text-gray-400">{{t "widget.radar.open"}}</span>
                {{#if this.stats.overdue}}
                    <Badge @status="error" @text={{concat this.stats.overdue " " (t "widget.radar.overdue")}} @hideIcon={{true}} @disableHumanize={{true}} @wrapperClass="text-[9px] px-1 py-0 font-bold" data-test-radar-widget-overdue />
                {{/if}}
            </div>
            <div class="mt-auto flex items-center justify-between text-[10px] text-gray-500 dark:text-gray-400">
                <span data-test-radar-widget-snoozed>{{this.stats.snoozed}} {{t "widget.radar.snoozed"}}</span>
                <LinkTo @route="management.index" class="inline-flex items-center gap-1 font-semibold text-blue-600 hover:text-blue-700 dark:text-blue-300 dark:hover:text-blue-200" data-test-radar-widget-link>
                    {{t "widget.radar.open-radar"}}
                    <FaIcon @icon="arrow-right" class="text-[9px]" />
                </LinkTo>
            </div>
        {{/if}}
    </div>
</div>
