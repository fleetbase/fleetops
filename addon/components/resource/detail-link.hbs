{{#if @record}}
    <button type="button" class="resource-detail-link" {{on "click" this.open}} ...attributes>
        {{#if @photo}}
            <Image src={{@photo}} @fallbackSrc={{@fallbackPhoto}} alt="" class="resource-detail-link__photo" data-shape={{or @shape "round"}} />
        {{/if}}
        <span class="resource-detail-link__text">
            <span class="resource-detail-link__title">{{@title}}</span>
            {{#if @subtitle}}
                <span class="resource-detail-link__subtitle">{{@subtitle}}</span>
            {{/if}}
        </span>
        <FaIcon @icon="arrow-up-right-from-square" @size="xs" class="resource-detail-link__icon" />
    </button>
{{else}}
    <span class="resource-detail-link resource-detail-link--empty">{{n-a @fallbackText}}</span>
{{/if}}
